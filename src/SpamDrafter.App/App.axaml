<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpamDrafter.App.ViewModels"
             x:Class="SpamDrafter.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.Resources>
    <DataTemplate x:Key="CardRow" x:DataType="vm:CardItem">
      <Grid ColumnDefinitions="Auto,*" Margin="2">
        <Border Width="52" Height="74" CornerRadius="3" ClipToBounds="True" Background="#22000000">
          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Summary}" Opacity="0.7" FontSize="12" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Application.Resources>
</Application>
