<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpamDrafter.App.ViewModels"
             xmlns:d="using:SpamDrafter.Core.Decks"
             xmlns:v="using:SpamDrafter.App.Views"
             x:Class="SpamDrafter.App.Views.GeneratorView"
             x:DataType="vm:GeneratorViewModel">
  <!-- Même disposition que le Deck builder : colonnes délimitées, largeur réglable à la souris. -->
  <Grid x:Name="RootGrid" Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.0*" MinWidth="220" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="1.4*" MinWidth="230" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="1.4*" MinWidth="260" />
    </Grid.ColumnDefinitions>

    <!-- Sélecteur de cartes -->
    <Border Classes="panel" Padding="14">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="title glow" Text="Cartes" FontSize="22" Foreground="{StaticResource BrushYellow}" Margin="-24,-12,-24,-2" />
      <v:CardGridPanel x:Name="Picker" ClickToAdd="True" DataContext="{Binding Browser}" TileWidth="104" TileHeight="148" />
    </DockPanel>
    </Border>
    <GridSplitter Classes="vgrip" Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip.Tip="Tirer pour régler la largeur des colonnes" />

    <!-- Sélection, réglage, propositions -->
    <Border Grid.Column="2" Classes="panel" Padding="14">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="title glow" Text="Cuisine" FontSize="22" Foreground="{StaticResource BrushYellow}" Margin="-24,-12,-24,-2" />
      <ScrollViewer>
      <StackPanel Spacing="8" Margin="0,0,8,0">
        <v:Collapse Header="Comment ça marche ?" HorizontalAlignment="Stretch">
          <v:MarkedText Source="{Binding HowItWorks}" TextWrapping="Wrap" FontSize="12" />
        </v:Collapse>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding FixedText}" Classes="hot" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Tout effacer" Command="{Binding ClearCommand}" Classes="danger" Padding="10,5" />
        </Grid>
        <!-- Même rendu que « Deck en cours » du Builder : cartes en grille de 2, ✕ dans le coin, talent dessous. -->
        <ItemsControl ItemsSource="{Binding Fixed}" VerticalAlignment="Top">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FixedSlotViewModel">
              <Border BorderBrush="{StaticResource BrushControlBorder}" Background="#22000000" BorderThickness="1" CornerRadius="10" Padding="10,12,10,8" Margin="4">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                  <ContentControl Width="112" Height="165" HorizontalAlignment="Center" Content="{Binding Card}" ContentTemplate="{StaticResource CardThumbFlat}" />
                  <Button Content="✕" Classes="danger" ClickMode="Press" MinWidth="34" MinHeight="30" HorizontalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" Padding="8,3" FontSize="13" ZIndex="5"
                          ToolTip.Tip="Retirer cette carte"
                          Command="{Binding $parent[UserControl].((vm:GeneratorViewModel)DataContext).RemoveCommand}"
                          CommandParameter="{Binding}" />
                  <ComboBox Grid.Row="1" ItemsSource="{Binding TalentOptions}" SelectedItem="{Binding Talent}" HorizontalAlignment="Stretch" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Lancer la cuisine" Command="{Binding GenerateCommand}" Classes="primary" Padding="16,8" />
          <Button Content="Annuler" Command="{Binding CancelCommand}" Classes="danger" />
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsBusy}" Height="6" />
        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsBusy}" Opacity="0.85">
          <TextBlock Text="{Binding CookStage}" FontSize="12" />
          <!-- Largeur réservée : les points apparaissent un à un sans faire bouger le pourcentage. -->
          <TextBlock Text="{Binding CookDots}" FontSize="12" Width="18" />
          <TextBlock Text="{Binding CookPercent}" FontSize="12" />
        </StackPanel>
        <TextBlock Text="{Binding Problem}" Classes="warn" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
        <TextBlock Text="{Binding Tip, StringFormat='Astuce : {0}'}" IsVisible="{Binding IsBusy}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource BrushYellow}" />
      </StackPanel>
      </ScrollViewer>
    </DockPanel>
    </Border>
    <GridSplitter Classes="vgrip" Grid.Column="3" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip.Tip="Tirer pour régler la largeur des colonnes" />

    <!-- Résultat de la génération : les decks proposés -->
    <Border Grid.Column="4" Classes="panel" Padding="14">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="title glow" Text="Résultat" FontSize="22" Foreground="{StaticResource BrushYellow}" Margin="-24,-12,-24,-2" />
      <TextBlock DockPanel.Dock="Top" IsVisible="{Binding !HasProposals}" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.8"
                 Text="Les decks proposés par le Grand Cuisinier apparaîtront ici, avec leur note sur 100." />
      <ScrollViewer IsVisible="{Binding HasProposals}" Margin="0,8,0,0">
        <ItemsControl ItemsSource="{Binding Proposals}" Grid.IsSharedSizeScope="True">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProposalViewModel">
              <!-- Toutes les propositions ont la même hauteur (groupe de taille partagé : celle de la plus haute, sans espace perdu) : titre, cartes, puis jauge et boutons calés en bas. -->
              <Grid RowDefinitions="Auto"><Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="ProposalBox" /></Grid.RowDefinitions>
              <Border BorderBrush="{StaticResource BrushControlBorder}" Background="#22000000" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,8,10,10">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="6">
                  <Button Grid.RowSpan="5" Content="✕" Classes="danger" ClickMode="Press" MinWidth="30" MinHeight="26" HorizontalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,-4,-4,0" Padding="6,2" FontSize="12" ZIndex="5" ToolTip.Tip="Retirer cette proposition"
                          Command="{Binding $parent[UserControl].((vm:GeneratorViewModel)DataContext).RemoveProposalCommand}"
                          CommandParameter="{Binding}" />
                  <WrapPanel ItemSpacing="10" LineSpacing="2" Margin="0,0,34,0" ToolTip.Tip="{Binding NoteDetail}">
                    <TextBlock Text="{Binding Title}" Classes="title" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NoteText}" Classes="value" FontSize="18" VerticalAlignment="Center" Foreground="{Binding NoteBrush}" />
                    <TextBlock Text="{Binding NoteLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding NoteBrush}" />
                    <TextBlock Text="{Binding NoteHint}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding HasNoteHint}" />
                  </WrapPanel>
                  <!-- Les 4 cartes du deck ; à leur droite, quand il y a la place, les cartes imposées pour la génération (nom + talent utilisé), en texte souligné cliquable. -->
                  <WrapPanel Grid.Row="1" ItemSpacing="14" LineSpacing="4">
                    <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource DeckChipTemplate}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="3" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel IsVisible="{Binding HasSource}" VerticalAlignment="Center" Spacing="2" MaxWidth="240">
                      <TextBlock Text="{Binding SourceTitle}" FontSize="11" Opacity="0.65" />
                      <ItemsControl ItemsSource="{Binding Source}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SourceCard">
                            <TextBlock Text="{Binding Label}" FontSize="13" TextDecorations="Underline" TextTrimming="CharacterEllipsis" Cursor="Hand"
                                       Foreground="{StaticResource BrushTextSecondary}" Tapped="SourceCard_Tapped" ToolTip.Tip="Voir la fiche de cette carte" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </WrapPanel>
                  <ProgressBar Grid.Row="3" Classes="gauge" Minimum="0" Maximum="100" Value="{Binding Gauge}" Height="8" ToolTip.Tip="{Binding NoteDetail}" />
                  <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                    <Button Content="Tester ce deck →" Classes="info" Padding="12,6"
                            Command="{Binding $parent[UserControl].((vm:GeneratorViewModel)DataContext).TestCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Sauvegarde cette proposition, puis l'ouvre dans l'onglet Deck Tester (fiche, analyse complète, comparaison)" />
                    <Button Content="{Binding SaveLabel}" Classes="soft" Padding="12,6"
                            Command="{Binding $parent[UserControl].((vm:GeneratorViewModel)DataContext).SaveCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
    </Border>
    <Button x:Name="ResetLayout" Grid.ColumnSpan="5" Content="Réinitialiser les dimensions" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,16,22,0" Padding="10,4" FontSize="12" Classes="info" ZIndex="20" ToolTip.Tip="Remet les colonnes à leur largeur d'origine" />
  </Grid>
</UserControl>
