<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpamDrafter.App.ViewModels"
        xmlns:v="using:SpamDrafter.App.Views"
        x:Class="SpamDrafter.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Classes.reduce="{Binding ReduceAnimations}"
        Title="SpamDrafter" Icon="/Assets/SpamDrafter.ico" Width="1280" Height="800" MinWidth="1000" MinHeight="640">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
    <KeyBinding Gesture="Ctrl+1" Command="{Binding SelectTabCommand}" CommandParameter="4" />
    <KeyBinding Gesture="Ctrl+2" Command="{Binding SelectTabCommand}" CommandParameter="0" />
    <KeyBinding Gesture="Ctrl+3" Command="{Binding SelectTabCommand}" CommandParameter="1" />
    <KeyBinding Gesture="Ctrl+4" Command="{Binding SelectTabCommand}" CommandParameter="2" />
    <KeyBinding Gesture="Ctrl+5" Command="{Binding SelectTabCommand}" CommandParameter="3" />
    <KeyBinding Gesture="Ctrl+6" Command="{Binding SelectTabCommand}" CommandParameter="5" />
    <KeyBinding Gesture="Ctrl+7" Command="{Binding SelectTabCommand}" CommandParameter="6" />
    <KeyBinding Gesture="Ctrl+8" Command="{Binding SelectTabCommand}" CommandParameter="7" />
  </Window.KeyBindings>
  <LayoutTransformControl LayoutTransform="{Binding UiTransform}">
  <Grid>
  <DockPanel Margin="80,0,0,0">
    <DockPanel DockPanel.Dock="Top" Margin="14,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" DataContext="{Binding Updater}">
        <TextBlock Text="{Binding Status}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" MaxWidth="80" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
        <Button Content="Redémarrer pour mettre à jour" Command="{Binding RestartCommand}"
                IsVisible="{Binding UpdateReady}" FontSize="12" Padding="8,2" />
        <Button Content="Rechercher une mise à jour" Command="{Binding CheckCommand}"
                IsVisible="{Binding IsInstalled}" FontSize="12" Padding="8,2" />
        <!-- Phase 15 : interrupteur « Toutes les cartes et talents / Cartes et talents possédés » et accès à la collection, à côté de « Paramètres ». -->
        <StackPanel Orientation="Horizontal" Spacing="8" DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext).Collection}" x:DataType="vm:CollectionViewModel">
          <StackPanel Orientation="Horizontal" Spacing="0" ToolTip.Tip="Choisis ce que les listes affichent : tout le jeu, ou seulement ce que tu possèdes dans SPAM.">
            <Button Classes="toggle" Classes.on="{Binding !OwnedOnly}" Command="{Binding SetModeCommand}" CommandParameter="all" Content="Toutes les cartes et talents" FontSize="11" Padding="6,2" CornerRadius="6,0,0,6" />
            <Button Classes="toggle" Classes.on="{Binding OwnedOnly}" Command="{Binding SetModeCommand}" CommandParameter="owned" Content="Cartes et talents possédés" FontSize="11" Padding="6,2" CornerRadius="0,6,6,0" />
          </StackPanel>
          <Panel>
            <Button Content="Importer" Command="{Binding OpenCommand}" IsEnabled="{Binding !$parent[Window].((vm:MainViewModel)DataContext).NavLocked}" FontSize="11" Padding="6,2" ToolTip.Tip="Importer les cartes et talents que tu possèdes dans SPAM" />
            <!-- Pendant le quizz, le bouton est désactivé mais un clic affiche quand même le message anti-triche. -->
            <Border Background="Transparent" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavLocked}" PointerPressed="LockedControl_Pressed" />
          </Panel>
        </StackPanel>
        <Button FontSize="12" Padding="8,2" DataContext="{Binding $parent[Window].DataContext}" ToolTip.Tip="Réglages, aide et données">
          <Button.Content>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <!-- Engrenage (Material Design Icons, Apache 2.0) -->
              <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"
                    Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
              <TextBlock Text="Paramètres" VerticalAlignment="Center" />
              <TextBlock Text="▾" FontSize="10" VerticalAlignment="Center" Opacity="0.8" />
            </StackPanel>
          </Button.Content>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <ScrollViewer MaxHeight="600" Width="310">
              <StackPanel Spacing="8" Margin="0,0,14,0" x:DataType="vm:MainViewModel">
                <TextBlock Classes="title" Text="Paramètres" FontSize="20" />
                <TextBlock Classes="title glow" Text="Couleurs" FontSize="15" Foreground="{StaticResource BrushYellow}" Margin="-24,-6,-24,-12" />
                <StackPanel Spacing="2"><TextBlock Text="Thème de couleur" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" /><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedIndex="{Binding ThemeIndex}" HorizontalAlignment="Stretch" /></StackPanel>
                <StackPanel Spacing="2"><TextBlock Text="Contour des cartes" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" /><ComboBox ItemsSource="{Binding CardFrameOptions}" SelectedIndex="{Binding CardFrameIndex}" HorizontalAlignment="Stretch" /></StackPanel>
                <TextBlock Classes="title glow" Text="Accessibilité" FontSize="15" Foreground="{StaticResource BrushYellow}" Margin="-24,-6,-24,-12" />
                <StackPanel Spacing="2"><TextBlock Text="Taille de l'interface" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" /><ComboBox ItemsSource="{Binding UiScaleOptions}" SelectedIndex="{Binding UiScaleIndex}" HorizontalAlignment="Stretch" /></StackPanel>
                <CheckBox Content="Contraste élevé" IsChecked="{Binding HighContrast}" />
                <TextBlock Classes="title glow" Text="Sons" FontSize="15" Foreground="{StaticResource BrushYellow}" Margin="-24,-6,-24,-12" />
                <CheckBox Content="Effets sonores" IsChecked="{Binding SoundsEnabled}" />
                <StackPanel Spacing="2"><TextBlock Text="Volume" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" /><Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding SoundVolume}" /></StackPanel>
                <CheckBox Content="Musique du jeu" IsChecked="{Binding MusicEnabled}" IsEnabled="{Binding HasMusic}" />
                <TextBlock Text="{Binding MusicHint}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" IsVisible="{Binding !HasMusic}" />
                <StackPanel Spacing="2" IsVisible="{Binding HasMusic}">
                    <TextBlock Text="Musique" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    <ComboBox ItemsSource="{Binding MusicTitles}" SelectedIndex="{Binding MusicIndex}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Volume de la musique" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                    <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding MusicVolume}" />
                </StackPanel>
                <TextBlock Classes="title glow" Text="Animations" FontSize="15" Foreground="{StaticResource BrushYellow}" Margin="-24,-6,-24,-12" />
                <CheckBox Content="Désactiver les animations" IsChecked="{Binding ReduceAnimations}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="title glow" Text="Particules" FontSize="15" Foreground="{StaticResource BrushYellow}" Margin="-24,-6,-24,-12" />
                  <Button Grid.Column="1" Content="Réglages par défaut" Command="{Binding ResetParticlesCommand}" IsVisible="{Binding ParticlesModified}" VerticalAlignment="Center" FontSize="11" Padding="8,2" />
                </Grid>
                <StackPanel Spacing="2"><TextBlock Text="Vitesse des particules" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" /><Slider Minimum="0.1" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding StarSpeed}" /></StackPanel>
                <StackPanel Spacing="2"><TextBlock Text="Nombre de particules" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" /><Slider Minimum="0" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding StarCount}" /></StackPanel>
                <StackPanel Spacing="2"><TextBlock Text="Taille des particules" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" /><Slider Minimum="0.3" Maximum="4" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding StarSize}" /></StackPanel>
                <StackPanel Spacing="2"><TextBlock Text="Couleur des particules" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" /><ComboBox ItemsSource="{Binding StarColorOptions}" SelectedIndex="{Binding StarColorIndex}" HorizontalAlignment="Stretch" /></StackPanel>
                <TextBlock Classes="title glow" Text="Aide" FontSize="15" Foreground="{StaticResource BrushYellow}" Margin="-24,-6,-24,-12" />
                <TextBlock Text="Raccourcis clavier" FontWeight="SemiBold" FontSize="13" />
                <StackPanel Spacing="4">
                <TextBlock Text="Ctrl+1 à Ctrl+8 : Accueil, Bibliothèque, Deck Builder, Drafter, Cuisine, Deck Tester, Challenges, Jeux" TextWrapping="Wrap" />
                <TextBlock Text="Ctrl+F : aller à la recherche" TextWrapping="Wrap" />
                <TextBlock Text="Échap : fermer la fiche d'une carte, vider la recherche" TextWrapping="Wrap" />
                <TextBlock Text="Clic sur une carte (Deck Builder, Drafter, Cuisine) : l'ajouter" TextWrapping="Wrap" />
                <TextBlock Text="Deck builder : Ctrl+S sauvegarder, Ctrl+N nouveau, Ctrl+D dupliquer, Ctrl+Z annuler, Ctrl+Y rétablir" TextWrapping="Wrap" />
                <TextBlock Text="Flèches ▲ ▼ dans « Mes decks » : choisir l'ordre des decks" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Classes="title glow" Text="Données" FontSize="15" Foreground="{StaticResource BrushYellow}" Margin="-24,-6,-24,-12" />
                <!-- Le moins utilisé : tout en bas. -->
                <Button Content="Importer des données…" Click="ImportData_Click" FontSize="12" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        ToolTip.Tip="Installer un fichier SpamDrafter-donnees-….zip (sans connexion)" />
              </StackPanel>
              </ScrollViewer>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
      <DockPanel>
        <TextBlock Text="{Binding Header}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </DockPanel>
    <!-- Phase 15 : interrupteur « Toutes les cartes et talents / Cartes et talents possédés » et accès à la collection. -->
    <!-- Sans données (premier lancement, erreur) : la bannière en grand au lieu d'une fenêtre vide. -->
    <TextBlock DockPanel.Dock="Top" Classes="title glow" Text="SpamDrafter" FontSize="64" Foreground="{StaticResource BrushYellow}" Margin="-10,48,-10,-12"
               HorizontalAlignment="Center" IsVisible="{Binding !IsLoaded}" />
    <!-- Quoi de neuf : SPAM a changé de version (phase 12, lot E) -->
    <Border DockPanel.Dock="Top" DataContext="{Binding WhatsNew}" IsVisible="{Binding IsVisible}" Margin="14,0,14,6"
            Background="#22E0B040" BorderBrush="#E0B040" BorderThickness="1" CornerRadius="6" Padding="10" x:DataType="vm:WhatsNewViewModel">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" />
        <ScrollViewer MaxHeight="160" IsVisible="{Binding DetailVisible}">
          <ItemsControl ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="12" TextWrapping="Wrap" Opacity="0.9" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <WrapPanel ItemSpacing="8" LineSpacing="6">
          <Button Content="{Binding DetailButtonLabel}" Command="{Binding ToggleDetailCommand}" FontSize="12" Padding="8,2" />
          <Button Content="{Binding ImpactedLabel}" Command="{Binding ShowImpactedCommand}" IsVisible="{Binding HasImpactedDecks}" FontSize="12" Padding="8,2" />
          <Button Content="Fermer" Command="{Binding DismissCommand}" FontSize="12" Padding="8,2" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <TextBlock DockPanel.Dock="Top" Text="{Binding LoadError}" IsVisible="{Binding HasError}"
               Foreground="#E07070" Margin="14" TextWrapping="Wrap" />
    <!-- Colonne d'icônes (opaque) + contenu sur panneau semi-transparent, devant le fond étoilé (phase 13, D-078). -->
    <Grid IsVisible="{Binding IsLoaded}" ColumnDefinitions="Auto,*">
      <!-- Texture animée du thème, derrière les particules. -->
      <v:ThemeTexture Grid.ColumnSpan="2" />
      <v:StarField Grid.ColumnSpan="2" />
      <Border Grid.Column="1" Classes="panel" Margin="12" Padding="0">
        <Panel x:Name="PagesHost">
          <v:HomeView x:Name="PageHome" v:PageFx.Enter="True" DataContext="{Binding Home}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsTab4}" />
          <v:LibraryTabsView x:Name="PageLibrary" v:PageFx.Enter="True" DataContext="{Binding LibraryTabs}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsTab0}" />
          <v:DeckBuilderView x:Name="PageBuilder" v:PageFx.Enter="True" DataContext="{Binding DeckBuilder}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsTab1}" />
          <v:DrafterView x:Name="PageDrafter" v:PageFx.Enter="True" DataContext="{Binding Drafter}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsTab2}" />
          <v:GeneratorView x:Name="PageGenerator" v:PageFx.Enter="True" DataContext="{Binding Generator}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsTab3}" />
          <v:ChallengesView x:Name="PageChallenges" v:PageFx.Enter="True" DataContext="{Binding Challenges}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsTab6}" />
          <v:GamesView x:Name="PageGames" v:PageFx.Enter="True" DataContext="{Binding Games}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsTab7}" />
          <v:TesterView x:Name="PageTester" v:PageFx.Enter="True" DataContext="{Binding Tester}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsTab5}" />
          <!-- Voile de démarrage : cache les pages pendant leur préchargement (elles sont affichées une fraction de seconde), puis s'efface en fondu. -->
          <!-- Message du quizz : les onglets sont verrouillés. -->
          <Border x:Name="LockToast" ZIndex="200" IsVisible="{Binding LockMessageVisible}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"
                  Background="#F0B03030" BorderBrush="#FFFFFF" BorderThickness="1.5" CornerRadius="12" Padding="22,12">
            <TextBlock Text="Pas de triche pendant le quizz du jour !" FontSize="20" FontWeight="Bold" Foreground="White" />
          </Border>
          <Border x:Name="PrewarmCover" ZIndex="100" Background="{StaticResource BrushPanelSolid}" CornerRadius="{StaticResource RadiusPanel}">
            <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.3" /></Transitions></Border.Transitions>
          </Border>
        </Panel>
      </Border>
      <!-- Fiche d'une carte ouverte par un clic droit : par-dessus l'onglet en cours, sans le quitter. -->
      <v:CardDetailView Grid.ColumnSpan="2" DataContext="{Binding QuickDetail}" />
      <!-- Ma collection (phase 15), par-dessus tout. -->
      <v:CollectionView Grid.ColumnSpan="2" DataContext="{Binding Collection}" />
    </Grid>
  </DockPanel>
  <!-- Barre latérale : de haut en bas de l'application. Repliée (icônes seules) ; au survol elle se déplie par-dessus le contenu et montre les noms. -->
  <Border x:Name="Rail" Classes="rail" HorizontalAlignment="Left" VerticalAlignment="Stretch" IsVisible="{Binding IsLoaded}" ZIndex="30" ClipToBounds="True">
    <Grid>
      <Border IsHitTestVisible="False" VerticalAlignment="Top" Height="160">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#22FFFFFF" Offset="0" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <DockPanel Margin="10,12,10,12">
        <!-- Titre : « SD » quand la barre est repliée, « SpamDrafter » quand elle est dépliée (un clic le fait rebondir). -->
        <!-- Logo animé au survol (voir BrandAnimator) : les cartes se redressent, la rose glisse à droite en dévoilant « pamDrafter », puis les rayons de la bannière tournent. -->
        <Grid x:Name="BrandBox" DockPanel.Dock="Top" Height="48" Margin="0,0,0,14" Background="Transparent">
          <Border x:Name="RaysBox" ZIndex="-1" CornerRadius="12" ClipToBounds="True" IsHitTestVisible="False">
            <Canvas>
              <Path x:Name="RaysPath" Fill="#15FFFFFF" Data="M0,0 L140.0,0.0 L137.2,28.1 Z M0,0 L126.1,60.7 L111.4,84.8 Z M0,0 L87.3,109.5 L63.6,124.7 Z M0,0 L31.2,136.5 L3.1,140.0 Z M0,0 L-31.2,136.5 L-57.9,127.5 Z M0,0 L-87.3,109.5 L-107.5,89.7 Z M0,0 L-126.1,60.7 L-135.8,34.2 Z M0,0 L-140.0,0.0 L-137.2,-28.1 Z M0,0 L-126.1,-60.7 L-111.4,-84.8 Z M0,0 L-87.3,-109.5 L-63.6,-124.7 Z M0,0 L-31.2,-136.5 L-3.1,-140.0 Z M0,0 L31.2,-136.5 L57.9,-127.5 Z M0,0 L87.3,-109.5 L107.5,-89.7 Z M0,0 L126.1,-60.7 L135.8,-34.2 Z" />
            </Canvas>
          </Border>
          <Border x:Name="LettersClip" ZIndex="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="41,0,0,0" ClipToBounds="True" Width="0" IsHitTestVisible="False">
            <StackPanel x:Name="LettersRow" Orientation="Horizontal" Spacing="0.5" HorizontalAlignment="Left">
              <TextBlock Text="p" Foreground="#FFD84D" FontFamily="{StaticResource FontTitle}" FontWeight="Bold" FontSize="23" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              <TextBlock Text="a" Foreground="#FFD84D" FontFamily="{StaticResource FontTitle}" FontWeight="Bold" FontSize="23" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              <TextBlock Text="m" Foreground="#FFD84D" FontFamily="{StaticResource FontTitle}" FontWeight="Bold" FontSize="23" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              <TextBlock Text="D" Foreground="#F4F0FF" FontFamily="{StaticResource FontTitle}" FontWeight="Bold" FontSize="23" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              <TextBlock Text="r" Foreground="#F4F0FF" FontFamily="{StaticResource FontTitle}" FontWeight="Bold" FontSize="23" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              <TextBlock Text="a" Foreground="#F4F0FF" FontFamily="{StaticResource FontTitle}" FontWeight="Bold" FontSize="23" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              <TextBlock Text="f" Foreground="#F4F0FF" FontFamily="{StaticResource FontTitle}" FontWeight="Bold" FontSize="23" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              <TextBlock Text="t" Foreground="#F4F0FF" FontFamily="{StaticResource FontTitle}" FontWeight="Bold" FontSize="23" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              <TextBlock Text="e" Foreground="#F4F0FF" FontFamily="{StaticResource FontTitle}" FontWeight="Bold" FontSize="23" VerticalAlignment="Bottom" Margin="0,0,0,3" />
              <TextBlock Text="r" Foreground="#F4F0FF" FontFamily="{StaticResource FontTitle}" FontWeight="Bold" FontSize="23" VerticalAlignment="Bottom" Margin="0,0,0,3" />
            </StackPanel>
          </Border>
          <Viewbox x:Name="PinkBox" ZIndex="2" Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False">
            <Canvas Width="40" Height="40">
              <Path x:Name="PinkPath" Data="M 11,7 h 16 a 3,3 0 0 1 3,3 v 20 a 3,3 0 0 1 -3,3 h -16 a 3,3 0 0 1 -3,-3 v -20 a 3,3 0 0 1 3,-3 z" Stroke="#FF7AC6" StrokeThickness="2.6" Fill="#2E2158" />
              <!-- Couronne à 3 piques, jaune pleine : à l'intérieur de la carte rose (elle apparaît quand les cartes se redressent). -->
              <Path x:Name="CrownPath" Data="M10.68,24.16 L10.16,17.14 L14.84,20.78 L19,15.84 L23.16,20.78 L27.84,17.14 L27.32,24.16 Z" Fill="#FFD84D" Stroke="#FFD84D" StrokeThickness="0.9" StrokeJoin="Round" Opacity="0" />
            </Canvas>
          </Viewbox>
          <Viewbox ZIndex="3" Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False">
            <Canvas Width="40" Height="40">
              <Path x:Name="YellowPath" Data="M 11,7 h 16 a 3,3 0 0 1 3,3 v 20 a 3,3 0 0 1 -3,3 h -16 a 3,3 0 0 1 -3,-3 v -20 a 3,3 0 0 1 3,-3 z" Stroke="#FFD84D" StrokeThickness="2.8" Fill="#3A2B66" />
              <Path x:Name="GlyphPath" Data="M 24,14 C 24,10.5 14,10.5 14,16 C 14,21.5 24,18.5 24,24 C 24,29.5 14,29.5 14,26" Stroke="#FFD84D" StrokeThickness="3" StrokeLineCap="Round" StrokeJoin="Round" />
            </Canvas>
          </Viewbox>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
          <Border Height="1" Margin="8,0" Background="{StaticResource BrushControlBorder}" Opacity="0.7" />
          <Button x:Name="ContactButton" Classes="nav">
            <Grid>
              
              <Viewbox Width="26" Height="26" HorizontalAlignment="Left" Margin="17,0,0,0" VerticalAlignment="Center">
            <Canvas Classes="ico i-contact" Width="24" Height="24">
              <Path Data="M4 5.5 a1.5 1.5 0 0 1 1.5 -1.5 h13 a1.5 1.5 0 0 1 1.5 1.5 v9 a1.5 1.5 0 0 1 -1.5 1.5 H10 l-4.5 4 V16 a1.5 1.5 0 0 1 -1.5 -1.5 Z" Fill="#B28DFF" Stroke="#8A5CF0" StrokeThickness="1.4" StrokeJoin="Round" />
              <Ellipse x:Name="ContactDot1" Canvas.Left="6.7" Canvas.Top="8.4" Width="2.6" Height="2.6" Fill="#F1E8FF" />
              <Ellipse x:Name="ContactDot2" Canvas.Left="10.7" Canvas.Top="8.4" Width="2.6" Height="2.6" Fill="#F1E8FF" />
              <Ellipse x:Name="ContactDot3" Canvas.Left="14.7" Canvas.Top="8.4" Width="2.6" Height="2.6" Fill="#F1E8FF" />
            </Canvas>
          </Viewbox>
              <TextBlock Classes="navlabel" Text="Contact" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="56,0,8,0" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="RightEdgeAlignedBottom">
                <StackPanel Width="290" Spacing="10">
                  <TextBlock Classes="title" Text="Contact" FontSize="20" />
                  <TextBlock TextWrapping="Wrap" FontSize="13" Text="Une idée, une suggestion ou un bug à signaler ? Écris-moi sur Discord." />
                  <Border Background="#22000000" BorderBrush="{StaticResource BrushControlBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel>
                        <TextBlock Text="Discord" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Text="RoiYanou" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushYellow}" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Copier" Click="CopyDiscord_Click" Padding="10,4" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Button Content="Ouvrir le GitHub du projet" Click="OpenGitHub_Click" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,8" />
                  <TextBlock Text="github.com/RoiYanou/SpamDrafter" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <StackPanel Spacing="6">
          <Button x:Name="NavHome" Classes="nav" Classes.locked="{Binding NavLocked}" Classes.on="{Binding IsTab4}" Command="{Binding SelectTabCommand}" CommandParameter="4">
            <Grid>
              <Border Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource BrushYellow}" IsVisible="{Binding IsTab4}" />
              <Viewbox Width="26" Height="26" HorizontalAlignment="Left" Margin="17,0,0,0" VerticalAlignment="Center">
            <Canvas Classes="ico i-home" Width="24" Height="24">
              <Path Data="M12 3 L2.5 11.5 H5 V20 a1 1 0 0 0 1 1 H18 a1 1 0 0 0 1 -1 V11.5 H21.5 Z" Fill="#FFC36B" Stroke="#E8782E" StrokeThickness="1.4" StrokeJoin="Round" />
              <Path x:Name="HomeHole" Data="M9.5 21 V15 a1.2 1.2 0 0 1 1.2 -1.2 h2.6 a1.2 1.2 0 0 1 1.2 1.2 V21 Z" Fill="#4A1E0C" />
              <!-- Porte coulissante : rognée à l'embrasure, elle glisse vers la gauche et disparaît « dans » le mur. -->
              <Canvas Width="24" Height="24" Clip="M9.5,13.5 H14.7 V21.2 H9.5 Z">
                <Path x:Name="HomeDoor" Data="M9.5 21 V15 a1.2 1.2 0 0 1 1.2 -1.2 h2.6 a1.2 1.2 0 0 1 1.2 1.2 V21 Z" Fill="#C45A24" Stroke="#8F3A12" StrokeThickness="0.5" StrokeJoin="Round" />
              </Canvas>
              <Path Data="M12 3 L2.5 11.5 H5.2 L12 5.4 L18.8 11.5 H21.5 Z" Fill="#FF6E3A" />
            </Canvas>
          </Viewbox>
              <TextBlock Classes="navlabel" Text="Accueil" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="56,0,8,0" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
          <Button x:Name="NavLibrary" Classes="nav" Classes.locked="{Binding NavLocked}" Classes.on="{Binding IsTab0}" Command="{Binding SelectTabCommand}" CommandParameter="0">
            <Grid>
              <Border Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource BrushYellow}" IsVisible="{Binding IsTab0}" />
              <Viewbox Width="26" Height="26" HorizontalAlignment="Left" Margin="17,0,0,0" VerticalAlignment="Center">
            <Canvas Classes="ico i-book" Width="24" Height="24">
              <Canvas x:Name="BookGroup" Width="24" Height="24">
                <!-- Corps du livre (celui d'origine, dos à gauche en x = 6) : dos bleu, page de droite, tranche blanche en bas. -->
                <Path Data="M6 3 H18 a1.5 1.5 0 0 1 1.5 1.5 V19.5 a1.5 1.5 0 0 1 -1.5 1.5 H7.5 a1.5 1.5 0 0 1 -1.5 -1.5 Z" Fill="#4DA3FF" Stroke="#2F6FD6" StrokeThickness="1.4" StrokeJoin="Round" />
                <Path Data="M7.4 4.4 H18.1 V17.6 H7.4 Z" Fill="#F3F8FF" />
                <Path Data="M9.2 7.6 H16.4 M9.2 10.6 H16.4 M9.2 13.6 H14" Stroke="#9DB9E0" StrokeThickness="1.1" StrokeLineCap="Round" />
                <Path Data="M6 19.5 a1.5 1.5 0 0 1 1.5 -1.5 H19.5 V21 H7.5 a1.5 1.5 0 0 1 -1.5 -1.5 Z" Fill="#E3F0FF" Stroke="#2F6FD6" StrokeThickness="1.2" StrokeJoin="Round" />
                <!-- Couverture : pivote autour du dos ; face extérieure fermée, face intérieure (page) une fois tournée. -->
                <Canvas x:Name="BookCover" Width="24" Height="24">
                  <Canvas x:Name="BookCoverOuter" Width="24" Height="24">
                    <Path Data="M6 3 H18 a1.5 1.5 0 0 1 1.5 1.5 V18 H7.5 a1.5 1.5 0 0 0 -1.5 1.5 Z" Fill="#4DA3FF" Stroke="#2F6FD6" StrokeThickness="1.4" StrokeJoin="Round" />
                    <Path Data="M9.5 7 H16 M9.5 10.5 H14" Stroke="#E3F0FF" StrokeThickness="1.6" StrokeLineCap="Round" />
                  </Canvas>
                  <Canvas x:Name="BookCoverInner" Width="24" Height="24" IsVisible="False">
                    <Path Data="M6 3 H18 a1.5 1.5 0 0 1 1.5 1.5 V19.5 a1.5 1.5 0 0 1 -1.5 1.5 H7.5 a1.5 1.5 0 0 1 -1.5 -1.5 Z" Fill="#4DA3FF" Stroke="#2F6FD6" StrokeThickness="1.4" StrokeJoin="Round" />
                    <Path Data="M7.4 4.4 H18.1 V17.6 H7.4 Z" Fill="#F3F8FF" />
                    <Path Data="M9.2 7.6 H16.4 M9.2 10.6 H16.4 M9.2 13.6 H14" Stroke="#9DB9E0" StrokeThickness="1.1" StrokeLineCap="Round" />
                    <Path Data="M6 19.5 a1.5 1.5 0 0 1 1.5 -1.5 H19.5 V21 H7.5 a1.5 1.5 0 0 1 -1.5 -1.5 Z" Fill="#E3F0FF" Stroke="#2F6FD6" StrokeThickness="1.2" StrokeJoin="Round" />
                  </Canvas>
                </Canvas>
              </Canvas>
            </Canvas>
          </Viewbox>
              <TextBlock Classes="navlabel" Text="Bibliothèque" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="56,0,8,0" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
          <Button x:Name="NavBuilder" Classes="nav" Classes.locked="{Binding NavLocked}" Classes.on="{Binding IsTab1}" Command="{Binding SelectTabCommand}" CommandParameter="1">
            <Grid>
              <Border Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource BrushYellow}" IsVisible="{Binding IsTab1}" />
              <Viewbox Width="26" Height="26" HorizontalAlignment="Left" Margin="17,0,0,0" VerticalAlignment="Center">
            <Canvas Classes="ico i-builder" Width="24" Height="24">
              <Rectangle x:Name="BuilderSq1" Canvas.Left="3" Canvas.Top="3" Width="8.5" Height="8.5" RadiusX="2.2" RadiusY="2.2" Fill="#6EE08A" />
              <Rectangle x:Name="BuilderSq2" Canvas.Left="12.5" Canvas.Top="3" Width="8.5" Height="8.5" RadiusX="2.2" RadiusY="2.2" Fill="#2EA85A" />
              <Rectangle x:Name="BuilderSq3" Canvas.Left="12.5" Canvas.Top="12.5" Width="8.5" Height="8.5" RadiusX="2.2" RadiusY="2.2" Fill="#3FC46A" />
              <Rectangle x:Name="BuilderSq4" Canvas.Left="3" Canvas.Top="12.5" Width="8.5" Height="8.5" RadiusX="2.2" RadiusY="2.2" Fill="#A6F0B5" />
            </Canvas>
          </Viewbox>
              <TextBlock Classes="navlabel" Text="Deck Builder" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="56,0,8,0" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
          <Button x:Name="NavDrafter" Classes="nav" Classes.locked="{Binding NavLocked}" Classes.on="{Binding IsTab2}" Command="{Binding SelectTabCommand}" CommandParameter="2">
            <Grid>
              <Border Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource BrushYellow}" IsVisible="{Binding IsTab2}" />
              <Viewbox Width="26" Height="26" HorizontalAlignment="Left" Margin="17,0,0,0" VerticalAlignment="Center">
            <Canvas x:Name="DrafterCanvas" Classes="ico i-drafter" Width="24" Height="24">
              <Path x:Name="DrafterPink" Data="M3 7 H7.5 C11.5 7 12 17 16.5 17 H18" Stroke="#FF7AC6" StrokeThickness="2.2" StrokeLineCap="Round" />
              <Path x:Name="DrafterHeadPink" Data="M17.5 13.2 L21.5 17 L17.5 20.8 Z" Fill="#FF7AC6" />
              <Path x:Name="DrafterPurpleA" Data="M3 17 H6.5 C8.2 17 9.2 15.6 10 14.2" Stroke="#C06BFF" StrokeThickness="2.2" StrokeLineCap="Round" />
              <Path x:Name="DrafterPurpleB" Data="M14 9.8 C14.8 8.4 15.6 7 17.5 7 H18" Stroke="#C06BFF" StrokeThickness="2.2" StrokeLineCap="Round" />
              <Path x:Name="DrafterHeadPurple" Data="M17.5 3.2 L21.5 7 L17.5 10.8 Z" Fill="#C06BFF" />
            </Canvas>
          </Viewbox>
              <TextBlock Classes="navlabel" Text="Drafter" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="56,0,8,0" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.locked="{Binding NavLocked}" Classes.on="{Binding IsTab3}" Command="{Binding SelectTabCommand}" CommandParameter="3" IsEnabled="{Binding HasGenerator}" ToolTip.Tip="{Binding GeneratorError}">
            <Grid>
              <Border Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource BrushYellow}" IsVisible="{Binding IsTab3}" />
              <Viewbox Width="26" Height="26" HorizontalAlignment="Left" Margin="17,0,0,0" VerticalAlignment="Center">
            <Canvas Classes="ico i-cook" Width="24" Height="24">
              <Canvas Classes="ico i-steam" Width="24" Height="24">
                <Canvas.RenderTransform><TranslateTransform /></Canvas.RenderTransform>
                <Path Data="M7.5 8 C6.3 6.6 8.7 5.4 7.5 3.6" Stroke="#DCE5F7" StrokeThickness="1.3" StrokeLineCap="Round" Opacity="0.7" />
                <Path Data="M11 7.5 C10 6.4 11.8 5.6 10.9 4.2" Stroke="#DCE5F7" StrokeThickness="1.1" StrokeLineCap="Round" Opacity="0.55" />
              </Canvas>
              <Canvas Classes="ico i-spoon" Width="24" Height="24">
                <Canvas.RenderTransform><RotateTransform /></Canvas.RenderTransform>
                <Path Data="M17.2 2.6 L12.6 11.2" Stroke="#C98A4B" StrokeThickness="2.1" StrokeLineCap="Round" />
                <Ellipse Canvas.Left="10.6" Canvas.Top="9.6" Width="4" Height="3.2" Fill="#E3A15C" />
              </Canvas>
              <Path Data="M4.5 11.5 H19.5 V15 a6 6 0 0 1 -6 6 H10.5 a6 6 0 0 1 -6 -6 Z" Fill="#8E9AB5" Stroke="#5D6B8A" StrokeThickness="1.3" StrokeJoin="Round" />
              <Path Data="M7 14.2 V15 a3.6 3.6 0 0 0 1.6 2.9" Stroke="#C9D3E8" StrokeThickness="1.2" StrokeLineCap="Round" />
              <Path Data="M3.6 11 a1.1 1.1 0 0 1 1.1 -1.1 H19.3 a1.1 1.1 0 0 1 1.1 1.1 a1.1 1.1 0 0 1 -1.1 1.1 H4.7 a1.1 1.1 0 0 1 -1.1 -1.1 Z" Fill="#B7C2DA" Stroke="#5D6B8A" StrokeThickness="1.1" StrokeJoin="Round" />
              <Path Data="M4.6 13.6 H2.2 V15.8 H4.6 M19.4 13.6 H21.8 V15.8 H19.4" Stroke="#5D6B8A" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" />
            </Canvas>
          </Viewbox>
              <TextBlock Classes="navlabel" Text="Cuisine" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="56,0,8,0" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.locked="{Binding NavLocked}" Classes.on="{Binding IsTab5}" Command="{Binding SelectTabCommand}" CommandParameter="5" IsEnabled="{Binding HasTester}">
            <Grid>
              <Border Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource BrushYellow}" IsVisible="{Binding IsTab5}" />
              <Viewbox Width="26" Height="26" HorizontalAlignment="Left" Margin="17,0,0,0" VerticalAlignment="Center">
            <Canvas Classes="ico i-tester" Width="24" Height="24">
              <Path Data="M4 18 A8 8 0 0 1 8 11.07" Stroke="#59D98E" StrokeThickness="3" />
              <Path Data="M8 11.07 A8 8 0 0 1 16 11.07" Stroke="#FFD84D" StrokeThickness="3" />
              <Path Data="M16 11.07 A8 8 0 0 1 20 18" Stroke="#FF5C5C" StrokeThickness="3" />
              <Canvas Classes="ico i-needle" Width="24" Height="24" RenderTransformOrigin="50%,75%">
                <Canvas.RenderTransform><RotateTransform Angle="35" /></Canvas.RenderTransform>
                <Path Data="M12 18 L12 10.2" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeLineCap="Round" />
              </Canvas>
              <Ellipse Canvas.Left="9.8" Canvas.Top="15.8" Width="4.4" Height="4.4" Fill="#FFFFFF" />
            </Canvas>
          </Viewbox>
              <TextBlock Classes="navlabel" Text="Deck Tester" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="56,0,8,0" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
          <Button x:Name="NavChallenges" Classes="nav" Classes.locked="{Binding NavLocked}" Classes.on="{Binding IsTab6}" Command="{Binding SelectTabCommand}" CommandParameter="6">
            <Grid>
              <Border Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource BrushYellow}" IsVisible="{Binding IsTab6}" />
              <Viewbox Width="26" Height="26" HorizontalAlignment="Left" Margin="17,0,0,0" VerticalAlignment="Center">
            <Canvas Classes="ico i-wheel" Width="24" Height="24">
              <Ellipse Canvas.Left="2" Canvas.Top="3" Width="20" Height="20" Fill="#2A1B52" Stroke="#FFD84D" StrokeThickness="1.6" />
              <Canvas x:Name="WheelSpin" Width="24" Height="24">
                <Path Data="M12 13 L12 4 A9 9 0 0 1 20.5 10 Z" Fill="#FF7AC6" />
                <Path Data="M12 13 L20.5 10 A9 9 0 0 1 17 20.5 Z" Fill="#5AB0FF" />
                <Path Data="M12 13 L17 20.5 A9 9 0 0 1 7 20.5 Z" Fill="#6EE08A" />
                <Path Data="M12 13 L7 20.5 A9 9 0 0 1 3.5 10 Z" Fill="#FFD84D" />
                <Path Data="M12 13 L3.5 10 A9 9 0 0 1 12 4 Z" Fill="#C06BFF" />
              </Canvas>
              <Ellipse Canvas.Left="10" Canvas.Top="11" Width="4" Height="4" Fill="#FFFFFF" />
              <Path Data="M9.5 0.8 L14.5 0.8 L12 5 Z" Fill="#FF5C5C" Stroke="#FFFFFF" StrokeThickness="0.8" StrokeJoin="Round" />
            </Canvas>
          </Viewbox>
              <TextBlock Classes="navlabel" Text="Challenges" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="56,0,8,0" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
          <Button x:Name="NavGames" Classes="nav" Classes.on="{Binding IsTab7}" Command="{Binding SelectTabCommand}" CommandParameter="7">
            <Grid>
              <Border Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource BrushYellow}" IsVisible="{Binding IsTab7}" />
              <Viewbox Width="44" Height="44" HorizontalAlignment="Left" Margin="8,-9,0,-9" VerticalAlignment="Center">
                <Canvas Classes="ico i-games" Width="42" Height="42">
                  <Canvas x:Name="DiceBody" Width="24" Height="24" Canvas.Left="9" Canvas.Top="9">
                    <Rectangle Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" RadiusX="5" RadiusY="5" Fill="#3A2670" Stroke="#FFD84D" StrokeThickness="1.6" />
                    <Ellipse x:Name="DicePipTL" Canvas.Left="5.2" Canvas.Top="5.2" Width="3.6" Height="3.6" Fill="#FFFFFF" />
                    <Ellipse x:Name="DicePipTR" Canvas.Left="15.2" Canvas.Top="5.2" Width="3.6" Height="3.6" Fill="#FFFFFF" />
                    <Ellipse x:Name="DicePipML" Canvas.Left="5.2" Canvas.Top="10.2" Width="3.6" Height="3.6" Fill="#FFFFFF" />
                    <Ellipse x:Name="DicePipC" Canvas.Left="10.2" Canvas.Top="10.2" Width="3.6" Height="3.6" Fill="#FFFFFF" />
                    <Ellipse x:Name="DicePipMR" Canvas.Left="15.2" Canvas.Top="10.2" Width="3.6" Height="3.6" Fill="#FFFFFF" />
                    <Ellipse x:Name="DicePipBL" Canvas.Left="5.2" Canvas.Top="15.2" Width="3.6" Height="3.6" Fill="#FFFFFF" />
                    <Ellipse x:Name="DicePipBR" Canvas.Left="15.2" Canvas.Top="15.2" Width="3.6" Height="3.6" Fill="#FFFFFF" />
                  </Canvas>
                </Canvas>
              </Viewbox>
              <TextBlock Classes="navlabel" Text="Jeux" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="56,0,8,0" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>
  </Grid>
  </LayoutTransformControl>
</Window>
