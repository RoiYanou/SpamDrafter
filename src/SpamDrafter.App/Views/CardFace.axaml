<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:SpamDrafter.App.Views"
             xmlns:vm="using:SpamDrafter.App.ViewModels"
             xmlns:imaging="using:Avalonia.Media.Imaging"
             x:Class="SpamDrafter.App.Views.CardFace"
             x:DataType="v:CardFace">
  <!-- Une carte (phase 13) : illustration rognée aux coins arrondis, cadre de rareté dessiné PAR-DESSUS l'image (le contour épouse
       toujours les coins), nom en haut au centre, élément en haut à gauche, Spamton et talent en haut à droite, symbole de rareté
       intégré au bas du cadre. Reflet holographique (fiche détaillée seulement) ; au survol, un exemplaire agrandi flotte au-dessus. -->
  <Border x:Name="Root" Classes="cardface" Background="Transparent" ToolTip.Tip="{Binding TooltipText}">
    <Grid>
      <!-- Le corps de la carte laisse en bas la place de la moitié du logo de rareté : le logo est donc TOUJOURS dans l'espace de la carte (rien ne peut le rogner ni le faire chevaucher la carte voisine). -->
      <Grid Margin="{Binding BodyReserve}">
      <Grid Margin="{Binding BodyMargin}">
        <Border Margin="{Binding ImageMargin}" CornerRadius="{Binding ImageCorner}" ClipToBounds="True" Background="#33000000">
          <Grid>
            <Image Source="{Binding Item.Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding ShowThumb}" />
            <!-- Grande tuile : version nette (440 px) par-dessus la miniature, qui reste dessous le temps du chargement. -->
            <Image Source="{Binding LargeImage}" Stretch="UniformToFill" IsHitTestVisible="False"
                   IsVisible="{Binding ImageOverride, Converter={x:Static ObjectConverters.IsNull}}" />
            <Image Source="{Binding ImageOverride}" Stretch="UniformToFill"
                   IsVisible="{Binding ImageOverride, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Border x:Name="HoloLayer" IsHitTestVisible="False" Opacity="0">
              <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions></Border.Transitions>
            </Border>
            <Border IsVisible="{Binding Credit, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" x:Name="CreditBox" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="{Binding CreditMargin}" Background="#B0000000" CornerRadius="4" Padding="6,2" IsHitTestVisible="False" Cursor="Hand">
              <!-- Le TextBlock rogne ce qui dépasse de sa propre zone : l'italique dépasse un peu de la dernière lettre, d'où une marge intérieure (Padding) et non extérieure. -->
              <TextBlock Text="{Binding Credit}" FontSize="{Binding CreditSize}" FontStyle="Italic" Foreground="White" TextTrimming="CharacterEllipsis" Padding="1,0,5,0" />
            </Border>
            <Border Classes="popnamebg" IsVisible="{Binding ShowName}" VerticalAlignment="Top" IsHitTestVisible="False" Padding="{Binding NamePadding}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#D0120A24" Offset="0" />
                  <GradientStop Color="#00120A24" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <v:OutlinedText Classes="pop popname" Text="{Binding Item.Name}" FontSize="{Binding NameSize}" HorizontalAlignment="Stretch"
                              FontFamily="{StaticResource FontTitle}" FontWeight="SemiBold" Foreground="White" />
            </Border>
          </Grid>
        </Border>
        <!-- Profondeur : ombre portée autour de la carte et ombre rentrante le long du cadre ; cadre métallique (reflets de la couleur de rareté). -->
        <Border CornerRadius="{Binding Corner}" BorderBrush="{Binding FrameShine}" BorderThickness="{Binding FrameThickness}" IsHitTestVisible="False"
                BoxShadow="inset 0 0 14 3 #B0000000" />
        <!-- Petit contour noir : au bord extérieur du cadre et là où il touche l'illustration. -->
        <Border CornerRadius="{Binding Corner}" BorderBrush="#E0000000" BorderThickness="1" IsHitTestVisible="False" />
        <Border CornerRadius="{Binding ImageCorner}" BorderBrush="#B0000000" BorderThickness="1" Margin="{Binding FrameThickness}" IsHitTestVisible="False" />
        <!-- Élément : l'icône seule, sans fond, avec un reflet métallique permanent. -->
        <Grid Classes="pop popel" IsVisible="{Binding ShowElement}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding OverlayMargin}"
              Width="{Binding Glyph}" Height="{Binding Glyph}" IsHitTestVisible="False">
          <Image Source="{Binding Item.ElementBadge}" Stretch="Uniform" />
          <!-- Reflet métallique animé en permanence : un éclat clair, bordé d'une ombre, traverse l'icône en diagonale (pinceau partagé, voir ElementSheen). -->
          <Rectangle IsVisible="{Binding On, Source={x:Static v:ElementSheen.State}}" Fill="{x:Static v:ElementSheen.Brush}">

            <Rectangle.OpacityMask><ImageBrush Source="{Binding Item.ElementBadgeMask}" Stretch="Uniform" /></Rectangle.OpacityMask>
          </Rectangle>
        </Grid>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{Binding OverlayMargin}" Spacing="3" IsHitTestVisible="False">
          <Grid Classes="pop popgold" IsVisible="{Binding ShowIncome}" HorizontalAlignment="Right" Width="{Binding Glyph}" Height="{Binding Glyph}">
            <Image Source="{Binding Item.SpamtonBadge}" Stretch="Uniform" />
            <Rectangle IsVisible="{Binding On, Source={x:Static v:ElementSheen.State}}" Fill="{x:Static v:ElementSheen.Brush}" IsHitTestVisible="False">
              <Rectangle.OpacityMask><ImageBrush Source="{Binding Item.SpamtonBadgeMask}" Stretch="Uniform" /></Rectangle.OpacityMask>
            </Rectangle>
            <TextBlock Text="{Binding Item.IncomeText}" FontSize="{Binding IncomeFont}" FontFamily="{StaticResource FontTitle}" FontWeight="Bold" Foreground="#6E3B14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <Border IsVisible="{Binding TopTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" HorizontalAlignment="Right"
                  Background="{StaticResource BrushYellow}" CornerRadius="999" Padding="6,0">
            <TextBlock Text="{Binding TopTag}" FontSize="{Binding TagSize}" FontWeight="Bold" Foreground="{StaticResource BrushOnYellow}" />
          </Border>
        </StackPanel>
        <!-- Capacités (comme dans le jeu) : un bandeau sombre translucide par capacité, nom en majuscules au centre, recharge à droite. -->
        <Grid Classes="pop popab" IsVisible="{Binding AbilitiesVisible}" VerticalAlignment="Bottom" Height="{Binding AbilitiesHeight}" Margin="{Binding AbilitiesMargin}" IsHitTestVisible="False">
        <ItemsControl ItemsSource="{Binding Item.AbilityTags}" VerticalAlignment="Top">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AbilityTag">
              <Border Background="{Binding Back}" CornerRadius="5"
                      Height="{Binding $parent[v:CardFace].AbilityRow}" Padding="3,0,3,0">
                <!-- Colonnes de largeur fixe (même sans icône ni recharge) : les noms sont toujours alignés d'une capacité à l'autre. -->
                <Grid>
                  <!-- Tox de base : logo collé au nom, le tout centré. -->
                  <StackPanel IsVisible="{Binding IsTox}" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Seul le logo est encadré, à la couleur de rareté du Tox (comme dans la fiche détaillée). -->
                    <Border BorderBrush="{Binding Frame}" BorderThickness="1.5" CornerRadius="{Binding $parent[v:CardFace].ToxCorner}" Background="#22000000" VerticalAlignment="Center"
                            Width="{Binding $parent[v:CardFace].AbilityIcon}" Height="{Binding $parent[v:CardFace].AbilityIcon}">
                      <Image Source="{Binding Logos[0]}" Stretch="Uniform" Margin="1" />
                    </Border>
                    <v:OutlinedText Text="{Binding Name}" FontSize="{Binding $parent[v:CardFace].AbilitySize}" FontWeight="ExtraBold" Foreground="White"
                                    VerticalAlignment="Center" MaxWidth="{Binding $parent[v:CardFace].ToxNameWidth}" />
                    <!-- Nom de la rareté du Tox, de la couleur de la rareté. -->
                    <v:OutlinedText Text="{Binding RarityName}" IsVisible="{Binding RarityName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    FontSize="{Binding $parent[v:CardFace].AbilitySize}" FontWeight="Bold" Foreground="{Binding RarityText}"
                                    VerticalAlignment="Center" MaxWidth="{Binding $parent[v:CardFace].ToxRarityWidth}" />
                  </StackPanel>
                  <!-- Éléments mis en jeu : un seul, ou un disque partagé en 2, 3 ou 6 parts comme dans le jeu. Sans élément : logo de critique et/ou de précision (fusionnés s'il y en a deux). -->
                  <v:ElementCombo HorizontalAlignment="Left" VerticalAlignment="Center" Icons="{Binding Elements}" IsVisible="{Binding HasElements}"
                                  Width="{Binding $parent[v:CardFace].AbilityIcon}" Height="{Binding $parent[v:CardFace].AbilityIcon}" />
                  <v:ElementCombo HorizontalAlignment="Left" VerticalAlignment="Center" Icons="{Binding Logos}" IsVisible="{Binding HasLogosOfAbility}"
                                  Width="{Binding $parent[v:CardFace].AbilityIcon}" Height="{Binding $parent[v:CardFace].AbilityIcon}" />
                  <v:OutlinedText IsVisible="{Binding IsAbility}" Text="{Binding Name}" FontSize="{Binding $parent[v:CardFace].AbilitySize}" FontWeight="ExtraBold" Foreground="White"
                                  VerticalAlignment="Center" Margin="{Binding $parent[v:CardFace].AbilityTextMargin}" />
                  <!-- Recharge : le logo « cooldown » de la fiche, avec le nombre de tours dedans. -->
                  <Grid HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding HasCooldown}"
                        Width="{Binding $parent[v:CardFace].AbilityLogo}" Height="{Binding $parent[v:CardFace].AbilityLogo}">
                    <Image Source="{Binding CooldownIcon}" Stretch="Uniform" />
                    <TextBlock Text="{Binding Cooldown}" FontWeight="Bold" FontSize="{Binding $parent[v:CardFace].CooldownFont}" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Grid>
        <!-- Talent en bas à gauche (présentation d'un deck) : « T1 » puis son nom, en gras. -->
        <!-- PV dans le coin bas gauche : un cœur vert puis « 500 PV », sans fond, avec un contour noir (texte noir décalé dessiné autour, voir OutlinedText). -->
        <StackPanel Classes="pop pophp" IsVisible="{Binding HpVisible}" Orientation="Horizontal" Spacing="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="{Binding HpMargin}" IsHitTestVisible="False">
          <!-- Pas de fond : cœur vert et « 500 PV » en blanc, avec un contour noir. -->
          <v:OutlinedText Text="♥" Foreground="#5FD86B" FontWeight="Black" FontSize="{Binding HpSize}" VerticalAlignment="Center" />
          <v:OutlinedText Text="{Binding Item.HpText}" Foreground="White" FontWeight="Black" FontSize="{Binding HpSize}" VerticalAlignment="Center" />
        </StackPanel>
        <!-- Talents possédés (mode « possédés ») : une étoile par talent, jaune si possédé, grise sinon, en bas à droite (à l'opposé des PV). -->
        <ItemsControl ItemsSource="{Binding Item.Stars}" IsVisible="{Binding HpVisible}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{Binding StarMargin}" IsHitTestVisible="False">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="0" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StarItem">
              <v:OutlinedText Text="★" Foreground="{Binding Fill}" FontWeight="Black" FontSize="{Binding $parent[v:CardFace].StarSize}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="{Binding BottomLeftMargin}" Spacing="3" IsHitTestVisible="False"
                    IsVisible="{Binding BottomTag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Border HorizontalAlignment="Left" Background="{StaticResource BrushYellow}" CornerRadius="999" Padding="7,0">
            <TextBlock Text="{Binding BottomTag}" FontSize="{Binding NameSize}" FontWeight="Bold" Foreground="{StaticResource BrushOnYellow}" />
          </Border>
          <Border IsVisible="{Binding TalentName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" HorizontalAlignment="Left"
                  MaxWidth="{Binding TalentMaxWidth}" Background="#D0120A24" CornerRadius="6" Padding="6,2">
            <TextBlock Text="{Binding TalentName}" FontSize="{Binding NameSize}" FontWeight="ExtraBold" TextWrapping="Wrap" Foreground="White" />
          </Border>
        </StackPanel>
      </Grid>
      <!-- Symbole de rareté : une arche sombre (même fond que l'icône d'élément) au contour du cadre, posée sur le bord bas et reliée à lui. -->
      </Grid>
      <!-- Logo de la rareté, seul, centré sur le bord bas du corps de la carte : la moitié du logo est sous le cadre, dans l'espace réservé. -->
      <Grid Classes="pop poprar" IsVisible="{Binding RarityLogoVisible}" Width="{Binding RarityLogo}" Height="{Binding RarityLogoHeight}" RenderOptions.BitmapInterpolationMode="HighQuality"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="{Binding RarityLogoMargin}" IsHitTestVisible="False">
        <Image Source="{Binding Item.RarityIcon}" Stretch="Uniform" />
        <Rectangle IsVisible="{Binding On, Source={x:Static v:ElementSheen.State}}" Fill="{x:Static v:ElementSheen.Brush}">
          <Rectangle.OpacityMask><ImageBrush Source="{Binding Item.RarityIcon}" Stretch="Uniform" /></Rectangle.OpacityMask>
        </Rectangle>
      </Grid>
    </Grid>
  </Border>
</UserControl>
