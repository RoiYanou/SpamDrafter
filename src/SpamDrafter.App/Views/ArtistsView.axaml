<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpamDrafter.App.ViewModels"
             xmlns:v="using:SpamDrafter.App.Views"
             x:Class="SpamDrafter.App.Views.ArtistsView"
             x:DataType="vm:ArtistsViewModel">
  <Grid ColumnDefinitions="360,*" Margin="12" ColumnSpacing="16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <TextBox Text="{Binding Search}" PlaceholderText="Rechercher un artiste…" />
        <ComboBox ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" HorizontalAlignment="Stretch" />
        <TextBlock Text="{Binding CountText}" Opacity="0.7" FontSize="12" />
      </StackPanel>
      <ListBox Classes="rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ArtistRow">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Count}" Opacity="0.6" FontSize="12" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="8" Margin="0,0,12,0">
        <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasLink}">
          <TextBlock Text="{Binding Link}" Opacity="0.8" VerticalAlignment="Center" />
          <Button Content="Ouvrir le lien" Command="{Binding OpenLinkCommand}" FontSize="12" Padding="8,2" />
        </StackPanel>
        <TextBlock Text="{Binding Message}" Foreground="#E0A050" />
        <TextBlock Text="{Binding CardsTitle}" FontWeight="SemiBold" Margin="0,14,0,0" IsVisible="{Binding HasSelection}" />
        <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardLinkRow}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
