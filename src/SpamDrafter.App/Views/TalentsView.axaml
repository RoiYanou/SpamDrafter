<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpamDrafter.App.ViewModels"
             xmlns:v="using:SpamDrafter.App.Views"
             x:Class="SpamDrafter.App.Views.TalentsView"
             x:DataType="vm:TalentsViewModel">
  <Grid ColumnDefinitions="360,*" Margin="12" ColumnSpacing="16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <TextBox Text="{Binding Search}" PlaceholderText="Rechercher un talent…" />
        <TextBlock Text="{Binding CountText}" Opacity="0.7" FontSize="12" />
      </StackPanel>
      <ListBox Classes="rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TalentRow">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Count}" Opacity="0.6" FontSize="12" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="8" Margin="0,0,12,0">
        <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.9" IsVisible="{Binding HasSelection}" />
        <TextBlock Text="{Binding CardsTitle}" FontWeight="SemiBold" Margin="0,14,0,0" IsVisible="{Binding HasSelection}" />
        <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardLinkRow}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
