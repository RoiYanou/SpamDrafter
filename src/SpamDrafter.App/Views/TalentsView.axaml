<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpamDrafter.App.ViewModels"
             xmlns:v="using:SpamDrafter.App.Views"
             x:Class="SpamDrafter.App.Views.TalentsView"
             x:DataType="vm:TalentsViewModel">
  <Grid ColumnDefinitions="360,*" Margin="12" ColumnSpacing="16" MaxWidth="1000" HorizontalAlignment="Stretch">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <TextBox Text="{Binding Search}" PlaceholderText="Rechercher un talent…" />
        <TextBlock Text="{Binding CountText}" Opacity="0.7" FontSize="12" />
      </StackPanel>
      <ListBox Classes="rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TalentRow">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Count}" Opacity="0.6" FontSize="12" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <Border Grid.Column="1" CornerRadius="14" Background="#26000000" BorderBrush="{StaticResource BrushPanelEdge}" BorderThickness="1" Padding="6,4,0,4">
    <Grid>
    <!-- Décor du panneau vide : étoile, filet doré et consigne. -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsHitTestVisible="False" Opacity="0.35" IsVisible="{Binding !HasSelection}">
      <TextBlock Text="✦" FontSize="72" HorizontalAlignment="Center" Foreground="{StaticResource BrushYellow}" />
      <Rectangle Width="160" Height="2" HorizontalAlignment="Center" Fill="{StaticResource BrushYellow}" Opacity="0.6" />
      <TextBlock Text="Choisis un talent dans la liste" FontSize="16" HorizontalAlignment="Center" />
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="8" Margin="0,0,12,0">
        <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.9" IsVisible="{Binding HasSelection}" />
        <TextBlock Text="{Binding CardsTitle}" FontWeight="SemiBold" Margin="0,14,0,0" IsVisible="{Binding HasSelection}" />
        <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardLinkRow}" />
      </StackPanel>
    </ScrollViewer>
    </Grid>
    </Border>
  </Grid>
</UserControl>
