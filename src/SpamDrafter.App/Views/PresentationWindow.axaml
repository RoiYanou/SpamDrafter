<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SpamDrafter.App.Views.PresentationWindow"
        Title="Présentation du deck" Width="1000" Height="720" MinWidth="700" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="16">
    <!-- Zone enregistrée en image : le fond, le titre et l'éventail de cartes (sans rognage : une version rognée et inclinée s'exportait mal). -->
    <Border x:Name="Stage" Background="{StaticResource BrushNight}" CornerRadius="16">
      <Grid RowDefinitions="Auto,*" Margin="24">
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <TextBlock x:Name="TitleText" Classes="title glow" FontSize="40" Foreground="{StaticResource BrushYellow}" HorizontalAlignment="Center" />
          <TextBlock Text="SpamDrafter (non officiel)" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" FontSize="13" />
        </StackPanel>
        <Canvas x:Name="Fan" Grid.Row="1" />
      </Grid>
    </Border>
    <!-- Atelier : les cartes sont dessinées ici (hors de l'écran) puis transformées en images avant d'être inclinées. -->
    <Canvas x:Name="Bake" Grid.RowSpan="2" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,12,0,0">
      <Button Classes="primary" Content="Enregistrer en image (PNG)" Click="Save_Click" Padding="14,6" />
      <Button Content="Fermer" Click="Close_Click" Padding="14,6" />
      <TextBlock x:Name="Message" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
