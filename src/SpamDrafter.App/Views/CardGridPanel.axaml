<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpamDrafter.App.ViewModels"
             xmlns:v="using:SpamDrafter.App.Views"
             x:Class="SpamDrafter.App.Views.CardGridPanel"
             x:DataType="vm:CardBrowser">
  <!-- Liste de cartes en grand quadrillage (phase 13) : filtres en une barre, cartes en vignettes qui remplissent la largeur. -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <Grid x:Name="SearchRow" ColumnDefinitions="Auto,*" ColumnSpacing="6">
        <Button Grid.Column="0" Click="ToggleFilters_Click" Padding="10,6" ToolTip.Tip="Réduire ou afficher le menu de tri et de filtres">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding FiltersToggleText}" />
            <TextBlock Text="● actif" Foreground="{StaticResource BrushYellow}" FontWeight="Bold" IsVisible="{Binding AnyFilterActive}" />
          </StackPanel>
        </Button>
        <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding Search}" PlaceholderText="Rechercher une carte, une capacité ou un talent…" />
      </Grid>
      <!-- Filtres (éléments, raretés, tri…) : un menu flottant par-dessus la liste de cartes, de la largeur de la barre de recherche, sur un fond translucide. -->
      <Popup x:Name="FilterPopup" Placement="Bottom" IsLightDismissEnabled="True" IsOpen="{Binding FiltersVisible, Mode=OneWay}">
        <LayoutTransformControl x:Name="FilterScale">
          <Border x:Name="FilterFrame" CornerRadius="12" BorderThickness="1.5" Padding="12" BoxShadow="0 6 18 0 #99000000">
      <StackPanel Spacing="8">
      <!-- Éléments et raretés : cases à cocher, combinables à volonté (aucune cochée = toutes). -->
      <ItemsControl ItemsSource="{Binding ElementChoices}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToggleOption">
            <Button Classes="logofilter" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding Label}">
              <Image Source="{Binding ShownIcon}" Height="26" Stretch="Uniform" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding RarityChoices}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToggleOption">
            <Button Classes="logofilter" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding Label}">
              <Image Source="{Binding ShownIcon}" Height="28" Stretch="Uniform" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
              <StackPanel Spacing="8">
          <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" HorizontalAlignment="Stretch" />
          <!-- « Filtrer par » : un seul menu avec des sous-menus (Régions, Espèces, Périodes) construits dans le code. -->
          <Button x:Name="LoreButton" Classes="combo">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding LoreSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Path Grid.Column="1" Data="M1,1.5 L4.5,5 L8,1.5" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" Width="10" Height="6" Stretch="Uniform" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>
              <Button Content="Réinitialiser" Click="ClearFilters_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,6" />
            </StackPanel>
          </Border>
        </LayoutTransformControl>
      </Popup>
      <TextBlock Text="{Binding CountText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
    </StackPanel>
    <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Classes="grid">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:CardItem">
          <!-- Le nom est écrit sur la carte (en haut au centre), plus besoin de le répéter dessous. -->
          <v:LazyTile ClipToBounds="False" Width="{Binding $parent[v:CardGridPanel].FitWidth}" Height="{Binding $parent[v:CardGridPanel].FitHeight}"
                      Item="{Binding}" ContentTemplate="{Binding $parent[v:CardGridPanel].ThumbTemplate}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
