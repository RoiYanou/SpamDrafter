<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpamDrafter.App.ViewModels"
             xmlns:v="using:SpamDrafter.App.Views"
             x:Class="SpamDrafter.App.Views.DrafterView"
             x:DataType="vm:DrafterViewModel">
  <!-- Même disposition que le Deck builder : colonnes délimitées, largeur réglable à la souris. -->
  <Grid x:Name="RootGrid" Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.4*" MinWidth="230" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="1.6*" MinWidth="230" />
    </Grid.ColumnDefinitions>

    <!-- Sélecteur de cartes -->
    <Border Classes="panel" Padding="14">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="title glow" Text="Cartes" FontSize="22" Foreground="{StaticResource BrushYellow}" Margin="-24,-12,-24,-2" />
      <v:CardGridPanel x:Name="Picker" ClickToAdd="True" DataContext="{Binding Browser}" TileWidth="104" TileHeight="148" />
    </DockPanel>
    </Border>
    <GridSplitter Classes="vgrip" Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip.Tip="Tirer pour régler la largeur des colonnes" />

    <!-- Recherche et résultats -->
    <Border Grid.Column="2" Classes="panel" Padding="14">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Classes="title glow" Text="Decks trouvés" FontSize="22" Foreground="{StaticResource BrushYellow}" Margin="-24,-12,-24,-2" />
      <StackPanel DockPanel.Dock="Top" Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding WantedText}" Classes="hot" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Tout effacer" Command="{Binding ClearCommand}" Classes="danger" Padding="10,5" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Wanted}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CardItem">
              <Border BorderBrush="{StaticResource BrushControlBorder}" Background="#22000000" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,10,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <ContentControl Width="58" Height="82" Content="{Binding}" ContentTemplate="{StaticResource CardThumbQuiet}" />
                  <TextBlock Text="{Binding Name}" Classes="title" VerticalAlignment="Center" />
                  <Button Content="✕" Classes="danger" VerticalAlignment="Center"
                          Command="{Binding $parent[UserControl].((vm:DrafterViewModel)DataContext).RemoveCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Message}" Classes="good" TextWrapping="Wrap" Margin="0,0,0,4" />
        <!-- Mêmes recherche, tri et filtres que « Mes decks » du Builder (partagés). -->
        <StackPanel Spacing="8" Margin="0,0,0,6" DataContext="{Binding Decks}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                    x:DataType="vm:DeckBuilderViewModel">
          <TextBox Text="{Binding DeckFilter}" PlaceholderText="Rechercher un deck…" />
          <v:Collapse HorizontalAlignment="Stretch" FontSize="12" Padding="0">
            <v:Collapse.Header>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Tri et filtres" />
                <TextBlock Text="● filtre actif" Foreground="{StaticResource BrushYellow}" FontWeight="Bold" IsVisible="{Binding DeckFiltersActive}" />
              </StackPanel>
            </v:Collapse.Header>
            <StackPanel Spacing="8" Margin="10,8,10,10">
              <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" HorizontalAlignment="Stretch" />
              <ComboBox ItemsSource="{Binding OriginOptions}" SelectedItem="{Binding OriginFilter}" HorizontalAlignment="Stretch" />
              <ComboBox ItemsSource="{Binding TagOptions}" SelectedItem="{Binding TagFilter}" HorizontalAlignment="Stretch" />
              <WrapPanel ItemSpacing="10" LineSpacing="6">
                <CheckBox Content="★ Favoris seulement" IsChecked="{Binding FavoritesOnly}" />
                <Button Content="Réinitialiser" Command="{Binding ClearDeckFiltersCommand}" FontSize="12" Padding="10,4" />
              </WrapPanel>
            </StackPanel>
          </v:Collapse>
        </StackPanel>
      </StackPanel>
      <!-- Les decks trouvés ont le même aspect que « Mes decks » du Builder : gros bouton au fond d'illustrations en diagonale, nom qui défile au survol. -->
      <ListBox x:Name="ResultsList" Classes="decks" ItemsSource="{Binding Results}">
        <ListBox.Styles>
          <Style Selector="StackPanel.deckdetail"><Setter Property="IsVisible" Value="False" /></Style>
          <Style Selector="ListBoxItem:selected StackPanel.deckdetail"><Setter Property="IsVisible" Value="True" /></Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DrafterResult">
            <StackPanel>
              <Grid Height="60" ClipToBounds="True">
                <v:DeckStrip Chips="{Binding Deck.Slots, Converter={x:Static vm:DeckChipsConverter.Instance}}" />
                <Border Width="4" Margin="14,9,0,9" CornerRadius="2" HorizontalAlignment="Left" Background="{Binding Deck.Id, Converter={x:Static vm:DeckDecor.ColorBrush}}" />
                <Grid Margin="30,0,12,0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="7" VerticalAlignment="Center">
                  <TextBlock Text="★" Foreground="#FFD35A" IsVisible="{Binding Deck.Favorite}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Deck.Id, Converter={x:Static vm:DeckDecor.Emoji}}" FontFamily="Segoe UI Emoji" FontSize="22" VerticalAlignment="Center" LineHeight="32" Padding="0,3,0,0" />
                  <v:MarqueeText Grid.Column="2" Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}">
                    <v:MarqueeText.Effect><DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="6" Color="#000000" Opacity="0.95" /></v:MarqueeText.Effect>
                  </v:MarqueeText>
                </Grid>
              </Grid>
              <StackPanel Classes="deckdetail" Spacing="8" Margin="12,10,12,12">
                <ItemsControl ClipToBounds="False" ItemsSource="{Binding Deck.Slots, Converter={x:Static vm:DeckChipsConverter.Instance}}" ItemTemplate="{StaticResource DeckChipLarge}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Content="Ouvrir dans le Deck builder" Classes="primary" Padding="12,6" HorizontalAlignment="Left"
                        Command="{Binding $parent[UserControl].((vm:DrafterViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Double-clic sur le deck : même chose" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    </Border>
    <Button x:Name="ResetLayout" Grid.ColumnSpan="3" Content="Réinitialiser les dimensions" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,16,22,0" Padding="10,4" FontSize="12" Classes="info" ZIndex="20" ToolTip.Tip="Remet les colonnes à leur largeur d'origine" />
  </Grid>
</UserControl>
