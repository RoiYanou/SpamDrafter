<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpamDrafter.App.ViewModels"
             xmlns:v="using:SpamDrafter.App.Views"
             x:Class="SpamDrafter.App.Views.CardDetailView"
             x:DataType="vm:LibraryViewModel">
  <!-- Fiche détaillée d'une carte, en fenêtre au centre sur un fond assombri : utilisée par la Bibliothèque et, par-dessus n'importe quel onglet,
       par le clic droit sur une carte. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseOverlayCommand}" />
  </UserControl.KeyBindings>
    <Border x:Name="Backdrop" Background="#99120A24" IsVisible="{Binding HasOverlay}">
      <Border Classes="panel" Background="{StaticResource BrushPanelSolid}" BorderBrush="{StaticResource BrushControlBorder}" BorderThickness="2"
              Padding="22" Margin="36,28" MaxWidth="980" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Center"
              BoxShadow="0 12 40 0 #AA000000">
      <Grid>
    <ScrollViewer Margin="0,0,44,0">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Width="300" VerticalAlignment="Top" Spacing="8" Margin="14,14,0,14" Panel.ZIndex="5">
        <!-- Fiche « vitrine » : la grande carte s'incline avec la souris et se retourne quand on change d'affichage. Elle passe devant le reste. -->
        <Border x:Name="Hero" Width="300" Height="430" VerticalAlignment="Top" RenderTransformOrigin="50%,50%">
          <Grid>
            <v:CardFace Item="{Binding Browser.Selected}" ImageOverride="{Binding Image}" ShowRarity="True" ShowElement="True" ShowIncome="True" HoverZoom="False" Holo="True" Credit="{Binding ArtistCredit}" />
          </Grid>
        </Border>
        <!-- Affichage de la carte : carte de base ou skin alternatif (retenu comme affichage par défaut). -->
        <StackPanel IsVisible="{Binding HasSkins}" Spacing="4" Margin="0,14,0,0">
          <TextBlock Text="Affichage par défaut" Classes="hint" />
          <ItemsControl ItemsSource="{Binding SkinOptions}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SkinOption">
                <Button Classes="toggle" Classes.on="{Binding IsSelected}" Content="{Binding Label}" Margin="0,0,6,6" Padding="10,4" FontSize="12"
                        Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).SelectSkinCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="6">
          <TextBlock Text="{Binding Title}" Classes="title glow" FontSize="30" Foreground="{StaticResource BrushYellow}" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="10" LineSpacing="4">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Image Source="{Binding ElementIcon}" Height="26" Width="26" Stretch="Uniform" />
              <TextBlock Text="{Binding ElementName}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Image Source="{Binding RarityIcon}" Height="22" Stretch="Uniform" />
              <TextBlock Text="{Binding RarityName}" Foreground="{Binding RarityTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="{Binding HpShort}" Classes="value" VerticalAlignment="Center" />
              <TextBlock Text="·" Opacity="0.6" VerticalAlignment="Center" />
              <Image Source="{Binding SpamtonIcon}" Height="22" Stretch="Uniform" />
              <TextBlock Text="{Binding IncomeShort}" Classes="value" VerticalAlignment="Center" />
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="Résistances" Classes="section" />
          <ItemsControl ItemsSource="{Binding ResistanceItems}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IconText">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Image Source="{Binding Icon}" Height="18" Width="18" Stretch="Uniform" />
                  <TextBlock Text="{Binding Text}" FontSize="12" Opacity="0.85" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Capacités" Classes="section" />
          <ItemsControl ItemsSource="{Binding AbilityLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AbilityLine">
                <StackPanel Margin="0,0,0,6">
                  <TextBlock Text="{Binding Name}" Classes="hot" FontSize="15" />
                  <TextBlock Text="{Binding Stats}" Classes="value" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Description}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Tox de base" Classes="section" IsVisible="{Binding HasInnateTox}" />
          <ItemsControl ItemsSource="{Binding InnateTox}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ToxLine">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,8">
                  <Border Width="52" Height="52" CornerRadius="8" BorderThickness="2" BorderBrush="{Binding Border}" Background="#22000000" ClipToBounds="True">
                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="4" IsVisible="{Binding HasImage}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding TextColor}" />
                      <TextBlock Text="{Binding RarityName}" Foreground="{Binding TextColor}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Opacity="0.8" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Talents" Classes="section" />
          <ItemsControl ItemsSource="{Binding Talents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TalentLine">
                <StackPanel Margin="0,0,0,6">
                  <TextBlock Text="{Binding Name}" Classes="hot" FontSize="15" />
                  <TextBlock Text="{Binding Description}" Opacity="0.85" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding DecksUsingTitle}" Classes="section" IsVisible="{Binding HasDecksUsing}" />
          <ItemsControl ItemsSource="{Binding DecksUsing}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DeckLine">
                <Button Content="{Binding Label}" Classes="info" Padding="10,3" Margin="0,2" HorizontalContentAlignment="Left"
                        Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).OpenDeckCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="Ouvrir dans le Deck builder" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border IsVisible="{Binding HasLore}" Background="#14808080" CornerRadius="6" Padding="10" Margin="0,16,0,0">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding LoreTags}" Classes="hot" TextWrapping="Wrap" />
              <TextBlock Text="{Binding LoreText}" TextWrapping="Wrap" FontSize="13" Opacity="0.9" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding CloseOverlayCommand}" Padding="10,4" FontSize="16"
            ToolTip.Tip="Fermer la fiche (Échap ou clic en dehors)" />
      </Grid>
      </Border>
    </Border>
</UserControl>
