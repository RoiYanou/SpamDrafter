<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpamDrafter.App.ViewModels"
             xmlns:v="using:SpamDrafter.App.Views"
             x:Class="SpamDrafter.App.Views.GameHistoryList"
             x:DataType="vm:GameHistoryViewModel">
  <!-- Historique d'un jeu quotidien : une ligne par partie (date, résultat), le détail se déplie dans la page (lignes séparées, compactes). -->
  <StackPanel Spacing="6">
    <TextBlock IsVisible="{Binding NoRows}" Text="Aucune partie pour le moment. Ta première partie apparaîtra ici avec sa date." Opacity="0.7" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:GameHistoryRow">
          <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Background="#14000000" Margin="0,0,0,6">
            <StackPanel>
              <Button Command="{Binding ToggleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,5" Background="Transparent" BorderThickness="0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Width="34" Height="48" CornerRadius="5" ClipToBounds="True" Background="#33000000" IsVisible="{Binding HasItem}">
                    <Image Source="{Binding Item.Thumbnail}" Stretch="UniformToFill" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding DayText}" FontWeight="SemiBold" FontSize="14" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Headline}" FontSize="13" FontWeight="Bold" Foreground="{Binding Color}" />
                      <TextBlock Text="{Binding CardName}" Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Arrow}" Opacity="0.7" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding IsOpen}" Margin="12,0,12,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GameHistoryLine">
                    <Border BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1" Padding="0,4">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Text="{Binding Mark}" FontWeight="Bold" Foreground="{Binding Color}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                          <Run Text="{Binding Text, Mode=OneWay}" /><Run Text="{Binding DetailSuffix, Mode=OneWay}" Foreground="#B0FFFFFF" FontSize="12" />
                        </TextBlock>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
