<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SpamDrafter.App.ViewModels"
             xmlns:v="using:SpamDrafter.App.Views"
             x:Class="SpamDrafter.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <Grid Margin="12">
    <v:CardGridPanel ClickOpensDetail="True" DataContext="{Binding Browser}" TileWidth="140" TileHeight="200" Columns="6" />
  </Grid>
</UserControl>
