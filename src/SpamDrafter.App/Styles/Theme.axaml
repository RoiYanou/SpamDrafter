<!-- Thème « Nuit étoilée » (phase 13, D-078). Voir docs/design/DIRECTIVES_VISUELLES.md.
     RÈGLE : aucune vue n'écrit une couleur ou une police en dur ; elle utilise les ressources ci-dessous. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Palette : violet 65 %, blanc 20 %, jaune 15 % -->
    <Color x:Key="ColorNight">#1A1033</Color>
    <Color x:Key="ColorPanel">#2B1B52</Color>
    <Color x:Key="ColorViolet">#4B2E8C</Color>
    <Color x:Key="ColorYellow">#FFC93C</Color>
    <Color x:Key="ColorOnYellow">#1A1033</Color>
    <SolidColorBrush x:Key="BrushNight" Color="{StaticResource ColorNight}" />
    <!-- Panneaux et menus : ≈ 72 % d'opacité pour laisser voir les étoiles. La colonne d'icônes, elle, est opaque (BrushRail). -->
    <SolidColorBrush x:Key="BrushPanel" Color="#B82B1B52" />
    <SolidColorBrush x:Key="BrushPanelSolid" Color="{StaticResource ColorPanel}" />
    <SolidColorBrush x:Key="BrushRail" Color="{StaticResource ColorPanel}" />
    <SolidColorBrush x:Key="BrushViolet" Color="{StaticResource ColorViolet}" />
    <!-- Cadres des capacités, talents et Tox de la fiche détaillée : suivent la couleur principale du thème (ThemeManager). -->
    <SolidColorBrush x:Key="BrushCardFill" Color="#4A3A7A" />
    <SolidColorBrush x:Key="BrushCardEdge" Color="#8E78D0" />
    <SolidColorBrush x:Key="BrushYellow" Color="{StaticResource ColorYellow}" />
    <SolidColorBrush x:Key="BrushOnYellow" Color="{StaticResource ColorOnYellow}" />
    <!-- Dégradés du décor : leurs couleurs sont réglées par ThemeManager selon le thème (violet, feu, eau…). -->
    <LinearGradientBrush x:Key="BrushPanelFill" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#D03B2A94" Offset="0" /><GradientStop Color="#C42B1B58" Offset="0.45" /><GradientStop Color="#D04A2078" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushPanelEdge" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#9A7BFF" Offset="0" /><GradientStop Color="#E070D0" Offset="0.4" /><GradientStop Color="#FFC93C" Offset="0.68" /><GradientStop Color="#5BC0F0" Offset="1" />
    </LinearGradientBrush>
    <!-- Boutons ordinaires et contour des boîtes : à la couleur secondaire du thème (ThemeManager). -->
    <LinearGradientBrush x:Key="BrushActionFill" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#D0A67F1F" Offset="0" /><GradientStop Color="#D07A5A12" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushActionHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#E8D9A82E" Offset="0" /><GradientStop Color="#E8A67F1F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrushActionEdge" Color="#FFC93C" />
    <LinearGradientBrush x:Key="BrushButtonFill" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#C08A5BE8" Offset="0" /><GradientStop Color="#C05A33AC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushButtonHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#E09B6BF5" Offset="0" /><GradientStop Color="#E06A3CC8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushSelectFill" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#B05A33C8" Offset="0" /><GradientStop Color="#B0A03C9C" Offset="1" />
    </LinearGradientBrush>
    <!-- Couleur secondaire du thème (jaune par défaut, une couleur complémentaire pour chaque thème d'élément) : réglée par ThemeManager. -->
    <LinearGradientBrush x:Key="BrushPrimaryFill" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#FFD84A" Offset="0" /><GradientStop Color="#FFA43A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushPrimaryHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#FFE57A" Offset="0" /><GradientStop Color="#FFB955" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrushAccentDark" Color="#E6B22E" />
    <SolidColorBrush x:Key="BrushAccentLight" Color="#FFE08A" />
    <SolidColorBrush x:Key="BrushAccentGlow" Color="#66FFC93C" />
    <DropShadowEffect x:Key="GlowEffect" OffsetX="0" OffsetY="0" BlurRadius="12" Color="#FFC93C" Opacity="0.55" />
    <SolidColorBrush x:Key="BrushText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#B3FFFFFF" />
    <!-- Nuances des commandes : boutons et menus (violet plus clair que le fond), champs de saisie (plus sombres que le fond). -->
    <SolidColorBrush x:Key="BrushControl" Color="#703B2377" />
    <SolidColorBrush x:Key="BrushControlBorder" Color="#8A6BD6" />
    <SolidColorBrush x:Key="BrushField" Color="#CC140A28" />
    <!-- Couleurs de texte : jaune (titres, liens), bleu clair (valeurs), rose (mises en avant), vert (réussite). -->
    <SolidColorBrush x:Key="BrushCyan" Color="#7DE3FF" />
    <SolidColorBrush x:Key="BrushPink" Color="#FF9AE0" />
    <SolidColorBrush x:Key="BrushGreen" Color="#82E9A8" />
    <SolidColorBrush x:Key="BrushWarning" Color="#E0A050" />
    <SolidColorBrush x:Key="BrushError" Color="#E07070" />

    <!-- Zones repliables : même fond que les panneaux -->
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#B82B1B52" />
    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#4B2E8C" />
    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#4B2E8C" />
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />

    <!-- Polices : titres Fredoka, texte Nunito (Assets/Fonts, licence SIL OFL jointe ; Segoe UI en secours). -->
    <FontFamily x:Key="FontTitle">avares://SpamDrafter/Assets/Fonts#Fredoka, Segoe UI</FontFamily>
    <FontFamily x:Key="FontBody">avares://SpamDrafter/Assets/Fonts#Nunito, Segoe UI</FontFamily>

    <!-- Échelle de tailles et grille de 8 px -->
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeLead">16</x:Double>
    <x:Double x:Key="FontSizeHeading">20</x:Double>
    <x:Double x:Key="FontSizeTitle">26</x:Double>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">12</CornerRadius>
  </Styles.Resources>

  <!-- Fond et texte de l'application -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BrushNight}" />
    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource FontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
  </Style>

  <!-- Panneau (semi-transparent) -->
  <!-- Poignée de colonne : un trait et une pastille à trois points, comme la poignée de hauteur. -->
  <Style Selector="GridSplitter.vgrip">
    <Setter Property="Width" Value="12" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border Width="2" Margin="0,4" Background="{StaticResource BrushControlBorder}" Opacity="0.7" HorizontalAlignment="Center" />
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="1.5,6" CornerRadius="6" Background="{StaticResource BrushViolet}" BorderBrush="{StaticResource BrushYellow}" BorderThickness="1">
            <StackPanel Spacing="3">
              <Ellipse Width="4" Height="4" Fill="{StaticResource BrushYellow}" />
              <Ellipse Width="4" Height="4" Fill="{StaticResource BrushYellow}" />
              <Ellipse Width="4" Height="4" Fill="{StaticResource BrushYellow}" />
            </StackPanel>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource BrushPanelFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushPanelEdge}" />
    <Setter Property="BoxShadow" Value="0 0 16 0 #22FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- Boutons : secondaire (par défaut) = texte blanc, fond transparent, bordure violet clair ;
       principal (classe « primary », un seul par écran) = fond jaune, texte violet très sombre. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource BrushActionFill}" />
    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushActionEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushActionHover}" />
    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushYellow}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushAccentDark}" />
    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
  </Style>
  <Style Selector="Button.primary, Button.accent">
    <Setter Property="Background" Value="{StaticResource BrushPrimaryFill}" />
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushPrimaryHover}" />
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushAccentDark}" />
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
  </Style>
  <!-- Boutons « neutres » (croix de fermeture, effacer, retirer) : gardent la couleur principale du thème, pas la secondaire. -->
  <Style Selector="Button.neutral">
    <Setter Property="Background" Value="{StaticResource BrushButtonFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
  </Style>
  <Style Selector="Button.neutral:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushButtonHover}" />
  </Style>
  <Style Selector="Button.neutral:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushViolet}" />
  </Style>
  <!-- Bouton à bascule (ex. « Base » / « Skin ») : la classe « on » le met en jaune. -->
  <Style Selector="Button.toggle.on">
    <Setter Property="Background" Value="{StaticResource BrushYellow}" />
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
  </Style>
  <Style Selector="Button.toggle.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushAccentLight}" />
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
  </Style>

  <!-- Carte : cadre de rareté ; survol = la carte monte de 6 px et grossit de 4 % en 140 ms (D-078). -->
  <Style Selector="Border.cardface">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.cardface.zoom:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-5px) scale(1.1)" />
  </Style>
  <!-- La carte survolée passe devant ses voisines. -->
  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="ZIndex" Value="10" />
  </Style>

  <!-- Clic : le bouton et la ligne de liste « s'enfoncent » (97 %) pendant 90 ms. -->
  <Style Selector="Button">
    <Setter Property="Transitions">
      <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="ListBoxItem:pressed">
    <Setter Property="RenderTransform" Value="scale(0.985)" />
  </Style>


  <!-- « Désactiver les animations » (classe « reduce » sur la fenêtre) : plus de transition, de fondu ni de reflet. -->
  <Style Selector="Window.reduce Border.cardface, Window.reduce Button">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Window.reduce Border.cardface:pointerover, Window.reduce Button:pressed, Window.reduce ListBoxItem:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- Succès : discret tant qu'il n'est pas acquis, jaune ensuite. -->
  <Style Selector="Border.badge">
    <Setter Property="BorderBrush" Value="{StaticResource BrushViolet}" />
  </Style>
  <Style Selector="Border.badge.done">
    <Setter Property="Background" Value="{StaticResource BrushYellow}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushYellow}" />
  </Style>
  <Style Selector="Border.badge.done TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Jauge de synergie : jaune, elle monte jusqu'à la note en 0,8 s. -->
  <Style Selector="ProgressBar.gauge">
    <Setter Property="Foreground" Value="{StaticResource BrushYellow}" />
    <Setter Property="Background" Value="#33FFFFFF" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Value" Duration="0:0:0.8" Easing="CubicEaseOut" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.reduce ProgressBar.gauge">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!-- Barre latérale repliée / dépliée : la largeur et les noms apparaissent en douceur au survol (ou tant que le menu Contact est ouvert). -->
  <Style Selector="Border.rail">
    <Setter Property="Width" Value="80" />
    <Setter Property="Background" Value="{StaticResource BrushPanelSolid}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.rail:pointerover, Border.rail.pinned">
    <Setter Property="Width" Value="212" />
    <Setter Property="BoxShadow" Value="6 0 22 0 #99000000" />
  </Style>
  <Style Selector="Border.rail TextBlock.navlabel">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.rail:pointerover TextBlock.navlabel, Border.rail.pinned TextBlock.navlabel">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- Entrée de la barre latérale : icône + nom, arrondie ; survol clair ; onglet choisi : fond lumineux jaune, texte et icône jaunes (le repère jaune est dans le gabarit). -->
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="0,11" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2AFFFFFF" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.nav.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#30FFC83C" Offset="0" />
        <GradientStop Color="#0CFFC83C" Offset="1" />
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Button.nav.on">
    <Setter Property="Foreground" Value="{StaticResource BrushYellow}" />
  </Style>
  <!-- Animations des icônes de la barre latérale au survol (coupées par « Désactiver les animations »). -->
  <Style Selector="Window:not(.reduce) Button.nav:pointerover Canvas.i-needle">
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="INFINITE" Easing="CubicEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="35" /></KeyFrame>
        <KeyFrame Cue="30%"><Setter Property="RotateTransform.Angle" Value="-52" /></KeyFrame>
        <KeyFrame Cue="65%"><Setter Property="RotateTransform.Angle" Value="68" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="35" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Window:not(.reduce) Button.nav:pointerover Canvas.i-spoon">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="-24" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="RotateTransform.Angle" Value="24" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="-24" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Window:not(.reduce) Button.nav:pointerover Canvas.i-steam">
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="INFINITE" Easing="LinearEasing">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="1.2" /><Setter Property="Opacity" Value="0.2" /></KeyFrame>
        <KeyFrame Cue="60%"><Setter Property="TranslateTransform.Y" Value="-1.6" /><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="-3" /><Setter Property="Opacity" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Button.nav:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Onglets -->
  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,12,6,8" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="Background" Value="#33000000" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
    <!-- Onglets fermés sur les quatre côtés : plus d'impression d'onglet « coupé » en bas. -->
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <!-- Navigation au clavier : cadre jaune bien visible sur la commande qui a le focus (accessibilité). -->
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource BrushYellow}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <!-- Pendant la saisie (et au survol), le champ garde le fond du thème : le thème de base le passait au noir. -->
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox:pointerover /template/ Border#PART_BorderElement, TextBox:focus:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource BrushField}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource BrushYellow}" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{StaticResource BrushYellow}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushYellow}" />
  </Style>
  <!-- Survol : seuls les onglets non choisis changent de couleur ; l'onglet choisi garde celle de la page, souris dessus ou non. -->
  <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter, TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, TabItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
  </Style>
  <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter, TabItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, TabItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource BrushYellow}" />
  </Style>


  <!-- Champs -->
  <!-- Champs de saisie : plus sombres que le fond, bordure claire ; menus déroulants : plus clairs que le fond. -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource BrushField}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource BrushControl}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <!-- Variantes de boutons : danger (rouge), information (bleu clair), doux (violet plein). -->
  <Style Selector="Button.danger">
    <Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#88E85A6A" Offset="0" /><GradientStop Color="#88B02A4A" Offset="1" /></LinearGradientBrush></Setter>
    <Setter Property="BorderBrush" Value="#E07070" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#99D04A4A" />
    <Setter Property="BorderBrush" Value="#FF9A9A" />
  </Style>
  <Style Selector="Button.info">
    <Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#8850B8F0" Offset="0" /><GradientStop Color="#88286CB0" Offset="1" /></LinearGradientBrush></Setter>
    <Setter Property="BorderBrush" Value="{StaticResource BrushCyan}" />
  </Style>
  <Style Selector="Button.info:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#992A6FA8" />
    <Setter Property="BorderBrush" Value="#B5F0FF" />
  </Style>
  <!-- « Présenter » : dégradé rose-violet lumineux, texte blanc. -->
  <Style Selector="Button.showcase">
    <Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#FF7AD9" Offset="0" /><GradientStop Color="#8B5CF6" Offset="1" /></LinearGradientBrush></Setter>
    <Setter Property="BorderBrush" Value="#FFC2F0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.showcase:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#FF98E4" Offset="0" /><GradientStop Color="#A07BFF" Offset="1" /></LinearGradientBrush></Setter>
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- Menu flottant sans marge ni largeur maximale : il prend toute la largeur que le code lui donne (menu « Détails et repères »). -->
  <Style Selector="FlyoutPresenter.tight">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxWidth" Value="2400" />
    <Setter Property="Opacity" Value="0.96" />
  </Style>
  <!-- Bouton qui a l'allure d'une liste déroulante (« Filtrer par ») : même fond, même bord, même hauteur, chevron à droite. -->
  <Style Selector="Button.combo">
    <Setter Property="Background" Value="{StaticResource BrushControl}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.soft">
    <Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#A09A6BF5" Offset="0" /><GradientStop Color="#A0603CB8" Offset="1" /></LinearGradientBrush></Setter>
    <Setter Property="BorderBrush" Value="#B79CFF" />
  </Style>
  <!-- Survol : un violet plus clair (le jaune du survol par défaut ne va pas avec ce bouton). -->
  <Style Selector="Button.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#C0B08CFF" Offset="0" /><GradientStop Color="#C0764BD8" Offset="1" /></LinearGradientBrush></Setter>
    <Setter Property="BorderBrush" Value="#D5C4FF" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.soft:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#B0603CB8" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Textes : titre de section (jaune, souligné), valeur (bleu clair, gras), mise en avant (rose), réussite (vert), alerte (orange, gras),
       lien (bleu, souligné), indication (italique, atténuée). -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontFamily" Value="{StaticResource FontTitle}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushYellow}" />
    <Setter Property="TextDecorations" Value="Underline" />
    <Setter Property="Margin" Value="0,14,0,4" />
  </Style>
  <!-- Lueur jaune sous les textes importants pour les faire ressortir. -->
  <!-- Marge intérieure + marge extérieure négative : la zone de dessin grandit (la lueur n'est plus coupée sur les côtés) sans bouger la mise en page. -->
  <Style Selector="TextBlock.glow, TextBlock.section">
    <Setter Property="Padding" Value="24,12" />
    <Setter Property="Margin" Value="-24,-12" />
    <Setter Property="Effect" Value="{StaticResource GlowEffect}" />
  </Style>
  <!-- Titre de l'application : blanc au survol. -->
  <Style Selector="TextBlock.apptitle">
    <Setter Property="Foreground" Value="{StaticResource BrushYellow}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="TextBlock.apptitle:pointerover">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.hot">
    <Setter Property="Foreground" Value="{StaticResource BrushPink}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.good">
    <Setter Property="Foreground" Value="{StaticResource BrushGreen}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.link">
    <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Séparateurs réglables entre colonnes : invisibles, jaunes au survol. -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{StaticResource BrushAccentGlow}" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Quadrillage de cartes : pas de marge parasite, une carte choisie est entourée de jaune. -->
  <!-- Case à cocher compacte (filtres d'élément et de rareté) : juste la case et l'icône. -->
  <Style Selector="CheckBox.chip">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="4,0,0,0" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <!-- Filtre par logo : un clic sur l'icône l'allume (couleur) ou l'éteint (noir et blanc) ; pas de cadre de bouton. -->
  <Style Selector="Button.logofilter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.logofilter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
  </Style>
  <Style Selector="CheckBox.chip /template/ Grid">
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <!-- Listes à lignes (Talents, Tox, Artistes) : un trait visible entre les lignes. -->
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <!-- Liste « Mes decks » : chaque deck est un gros bouton arrondi (bord clair, survol et sélection en jaune, main au survol). -->
  <Style Selector="ListBox.decks ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
    <Setter Property="Background" Value="#33000000" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- Pas de rognage : les cartes agrandies au survol dépassent par-dessus le bord de la boîte (le fond en bandes se rogne lui-même). -->
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="ListBox.decks ListBoxItem:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentLight}" />
  </Style>
  <Style Selector="ListBox.decks ListBoxItem:selected">
    <Setter Property="BorderBrush" Value="{StaticResource BrushYellow}" />
  </Style>
  <Style Selector="ListBox.decks ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.decks ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.decks ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33000000" />
  </Style>
  <Style Selector="ListBox.grid">
    <Setter Property="Padding" Value="9,16,9,12" />
  </Style>
  <Style Selector="ListBox.decks">
    <Setter Property="Padding" Value="0,14,0,10" />
  </Style>
  <!-- Listes qui défilent : leurs bords haut et bas s'estompent en douceur au lieu d'être coupés net. -->
  <Style Selector="ListBox.grid, ListBox.decks, ListBox.rows">
    <Setter Property="OpacityMask">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#FF000000" Offset="0.04" />
        <GradientStop Color="#FF000000" Offset="0.96" />
        <GradientStop Color="#00000000" Offset="1" />
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="ListBox.grid ListBoxItem">
    <!-- Vertical réduit : le symbole de rareté (≈ 6 px) dépasse du cadre, ce qui rend l'écart entre les lignes égal à celui entre les colonnes. -->
    <!-- Aucune marge intérieure : la zone cliquable colle exactement à la carte (l'écart entre cartes vient de la marge extérieure, 9 × 6). -->
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="9,6" />
    <Setter Property="CornerRadius" Value="12" />
    <!-- La carte agrandie au survol déborde de sa case : la case ne la rogne pas. -->
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="ListBox.grid ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.grid ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{x:Null}" />
  </Style>
  <Style Selector="ListBox.grid ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#554B2E8C" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushYellow}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushSelectFill}" />
  </Style>
</Styles>
