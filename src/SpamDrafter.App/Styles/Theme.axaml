<!-- Thème « Nuit étoilée » (phase 13, D-078). Voir docs/design/DIRECTIVES_VISUELLES.md.
     RÈGLE : aucune vue n'écrit une couleur ou une police en dur ; elle utilise les ressources ci-dessous. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Palette : violet 65 %, blanc 20 %, jaune 15 % -->
    <Color x:Key="ColorNight">#1A1033</Color>
    <Color x:Key="ColorPanel">#2B1B52</Color>
    <Color x:Key="ColorViolet">#4B2E8C</Color>
    <Color x:Key="ColorYellow">#FFC93C</Color>
    <Color x:Key="ColorOnYellow">#1A1033</Color>
    <SolidColorBrush x:Key="BrushNight" Color="{StaticResource ColorNight}" />
    <!-- Panneaux et menus : ≈ 72 % d'opacité pour laisser voir les étoiles. La colonne d'icônes, elle, est opaque (BrushRail). -->
    <SolidColorBrush x:Key="BrushPanel" Color="#B82B1B52" />
    <SolidColorBrush x:Key="BrushPanelSolid" Color="{StaticResource ColorPanel}" />
    <SolidColorBrush x:Key="BrushRail" Color="{StaticResource ColorPanel}" />
    <SolidColorBrush x:Key="BrushViolet" Color="{StaticResource ColorViolet}" />
    <SolidColorBrush x:Key="BrushYellow" Color="{StaticResource ColorYellow}" />
    <SolidColorBrush x:Key="BrushOnYellow" Color="{StaticResource ColorOnYellow}" />
    <SolidColorBrush x:Key="BrushText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#B3FFFFFF" />
    <!-- Nuances des commandes : boutons et menus (violet plus clair que le fond), champs de saisie (plus sombres que le fond). -->
    <SolidColorBrush x:Key="BrushControl" Color="#703B2377" />
    <SolidColorBrush x:Key="BrushControlBorder" Color="#8A6BD6" />
    <SolidColorBrush x:Key="BrushField" Color="#CC140A28" />
    <!-- Couleurs de texte : jaune (titres, liens), bleu clair (valeurs), rose (mises en avant), vert (réussite). -->
    <SolidColorBrush x:Key="BrushCyan" Color="#7DE3FF" />
    <SolidColorBrush x:Key="BrushPink" Color="#FF9AE0" />
    <SolidColorBrush x:Key="BrushGreen" Color="#82E9A8" />
    <SolidColorBrush x:Key="BrushWarning" Color="#E0A050" />
    <SolidColorBrush x:Key="BrushError" Color="#E07070" />

    <!-- Zones repliables : même fond que les panneaux -->
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#B82B1B52" />
    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#4B2E8C" />
    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#4B2E8C" />
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />

    <!-- Polices : titres Fredoka, texte Nunito (Assets/Fonts, licence SIL OFL jointe ; Segoe UI en secours). -->
    <FontFamily x:Key="FontTitle">avares://SpamDrafter/Assets/Fonts#Fredoka, Segoe UI</FontFamily>
    <FontFamily x:Key="FontBody">avares://SpamDrafter/Assets/Fonts#Nunito, Segoe UI</FontFamily>

    <!-- Échelle de tailles et grille de 8 px -->
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeLead">16</x:Double>
    <x:Double x:Key="FontSizeHeading">20</x:Double>
    <x:Double x:Key="FontSizeTitle">26</x:Double>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">12</CornerRadius>
  </Styles.Resources>

  <!-- Fond et texte de l'application -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BrushNight}" />
    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource FontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
  </Style>

  <!-- Panneau (semi-transparent) -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource BrushPanel}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushViolet}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- Boutons : secondaire (par défaut) = texte blanc, fond transparent, bordure violet clair ;
       principal (classe « primary », un seul par écran) = fond jaune, texte violet très sombre. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource BrushControl}" />
    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushViolet}" />
    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushYellow}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushViolet}" />
    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
  </Style>
  <Style Selector="Button.primary, Button.accent">
    <Setter Property="Background" Value="{StaticResource BrushYellow}" />
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FFD866" />
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E6B22E" />
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
  </Style>
  <!-- Bouton à bascule (ex. « Base » / « Skin ») : la classe « on » le met en jaune. -->
  <Style Selector="Button.toggle.on">
    <Setter Property="Background" Value="{StaticResource BrushYellow}" />
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
  </Style>
  <Style Selector="Button.toggle.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FFD866" />
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
  </Style>

  <!-- Carte : cadre de rareté ; survol = la carte monte de 6 px et grossit de 4 % en 140 ms (D-078). -->
  <Style Selector="Border.cardface">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.cardface.zoom:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-5px) scale(1.1)" />
  </Style>
  <!-- La carte survolée passe devant ses voisines. -->
  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="ZIndex" Value="10" />
  </Style>

  <!-- Clic : le bouton et la ligne de liste « s'enfoncent » (97 %) pendant 90 ms. -->
  <Style Selector="Button">
    <Setter Property="Transitions">
      <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="ListBoxItem:pressed">
    <Setter Property="RenderTransform" Value="scale(0.985)" />
  </Style>

  <!-- Changement d'onglet : la page apparaît en fondu en 180 ms. -->
  <Style Selector="UserControl.page[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.18" FillMode="Both">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- « Réduire les animations » (classe « reduce » sur la fenêtre) : plus de transition, de fondu ni de reflet. -->
  <Style Selector="Window.reduce Border.cardface, Window.reduce Button">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Window.reduce Border.cardface:pointerover, Window.reduce Button:pressed, Window.reduce ListBoxItem:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Window.reduce UserControl.page[IsVisible=True]">
    <Style.Animations><Animation Duration="0:0:0.001" /></Style.Animations>
  </Style>

  <!-- Succès : discret tant qu'il n'est pas acquis, jaune ensuite. -->
  <Style Selector="Border.badge">
    <Setter Property="BorderBrush" Value="{StaticResource BrushViolet}" />
  </Style>
  <Style Selector="Border.badge.done">
    <Setter Property="Background" Value="{StaticResource BrushYellow}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushYellow}" />
  </Style>
  <Style Selector="Border.badge.done TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Jauge de synergie : jaune, elle monte jusqu'à la note en 0,8 s. -->
  <Style Selector="ProgressBar.gauge">
    <Setter Property="Foreground" Value="{StaticResource BrushYellow}" />
    <Setter Property="Background" Value="#33FFFFFF" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Value" Duration="0:0:0.8" Easing="CubicEaseOut" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.reduce ProgressBar.gauge">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>

  <!-- Entrée de la colonne d'icônes : icône + libellé, large, jaune quand elle est choisie. -->
  <Style Selector="Button.rail">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
  </Style>
  <Style Selector="Button.rail.on">
    <Setter Property="Foreground" Value="{StaticResource BrushOnYellow}" />
  </Style>
  <Style Selector="Button.rail:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Onglets -->
  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Navigation au clavier : cadre jaune bien visible sur la commande qui a le focus (accessibilité). -->
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource BrushYellow}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource BrushYellow}" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{StaticResource BrushYellow}" />
  </Style>

  <!-- Champs -->
  <!-- Champs de saisie : plus sombres que le fond, bordure claire ; menus déroulants : plus clairs que le fond. -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource BrushField}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource BrushControl}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <!-- Variantes de boutons : danger (rouge), information (bleu clair), doux (violet plein). -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#55D04A4A" />
    <Setter Property="BorderBrush" Value="#E07070" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#99D04A4A" />
    <Setter Property="BorderBrush" Value="#FF9A9A" />
  </Style>
  <Style Selector="Button.info">
    <Setter Property="Background" Value="#552A6FA8" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushCyan}" />
  </Style>
  <Style Selector="Button.info:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#992A6FA8" />
    <Setter Property="BorderBrush" Value="#B5F0FF" />
  </Style>
  <Style Selector="Button.soft">
    <Setter Property="Background" Value="#885B3AA8" />
    <Setter Property="BorderBrush" Value="#B79CFF" />
  </Style>

  <!-- Textes : titre de section (jaune, souligné), valeur (bleu clair, gras), mise en avant (rose), réussite (vert), alerte (orange, gras),
       lien (bleu, souligné), indication (italique, atténuée). -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontFamily" Value="{StaticResource FontTitle}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushYellow}" />
    <Setter Property="TextDecorations" Value="Underline" />
    <Setter Property="Margin" Value="0,14,0,4" />
  </Style>
  <!-- Lueur jaune sous les textes importants pour les faire ressortir. -->
  <Style Selector="TextBlock.glow, TextBlock.section">
    <Setter Property="Effect">
      <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="12" Color="#FFC93C" Opacity="0.55" />
    </Setter>
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.hot">
    <Setter Property="Foreground" Value="{StaticResource BrushPink}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.good">
    <Setter Property="Foreground" Value="{StaticResource BrushGreen}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.link">
    <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Séparateurs réglables entre colonnes : invisibles, jaunes au survol. -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="#66FFC93C" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Quadrillage de cartes : pas de marge parasite, une carte choisie est entourée de jaune. -->
  <!-- Case à cocher compacte (filtres d'élément et de rareté) : juste la case et l'icône. -->
  <Style Selector="CheckBox.chip">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="4,0,0,0" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="CheckBox.chip /template/ Grid">
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <!-- Listes à lignes (Talents, Tox, Artistes) : un trait visible entre les lignes. -->
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="BorderBrush" Value="{StaticResource BrushControlBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ListBox.grid ListBoxItem">
    <Setter Property="Padding" Value="6" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="ListBox.grid ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#554B2E8C" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushYellow}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BrushViolet}" />
  </Style>
</Styles>
