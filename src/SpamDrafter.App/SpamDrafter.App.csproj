<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Version du programme ; le numéro du paquet Velopack (vpk pack -v) doit être le même. -->
    <Version>1.0.0</Version>
    <AssemblyName>SpamDrafter</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Génération et analyse : beaucoup de duels en parallèle ; le ramasse-miettes « serveur » occupe mieux les cœurs. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpamDrafter.Core\SpamDrafter.Core.csproj" />
    <ProjectReference Include="..\SpamDrafter.Engines\SpamDrafter.Engines.csproj" />
  </ItemGroup>
</Project>
