<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Version du programme ; le numéro du paquet Velopack (vpk pack -v) doit être le même. -->
    <Version>1.3.1</Version>
    <AssemblyName>SpamDrafter</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Génération et analyse : beaucoup de duels en parallèle ; le ramasse-miettes « serveur » occupe mieux les cœurs. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Icône du programme (SpamDrafter.exe, raccourcis), fabriquée à partir de Assets/logo.png. -->
    <ApplicationIcon>Assets\SpamDrafter.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Logo, icône et bannière de l'application, intégrés au programme. -->
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Remove="Assets\Sounds\**" />
    <EmbeddedResource Include="Assets\Sounds\*.wav" LogicalName="Sounds/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Sounds\*.ogg" LogicalName="Sounds/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpamDrafter.Core\SpamDrafter.Core.csproj" />
    <ProjectReference Include="..\SpamDrafter.Engines\SpamDrafter.Engines.csproj" />
  </ItemGroup>
</Project>
